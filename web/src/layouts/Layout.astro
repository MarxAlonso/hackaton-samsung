---
import "../styles/global.css";
import { icon } from "../lib/icons";
import app from "../../public/data/app.json";
import { GLOSARIO } from "../lib/glossary";

interface Props {
  title: string;
  description?: string;
  active?: "inicio" | "ciudadano" | "autoridad" | "plan" | "impacto" | "nino2027" | "modelo";
  wide?: boolean;
}
const { title, description = "Alertas tempranas de dengue y enfermedades asociadas a El Niño por distrito.", active, wide = false } = Astro.props;
const fechaCorta = (iso: string) => new Date(iso + "T12:00:00").toLocaleDateString("es-PE", { day: "numeric", month: "short", year: "numeric" });
// short: lo que cabe en la barra de escritorio; label: el nombre completo (menú del celular y lectores de pantalla)
const nav = [
  { href: "/ciudadano", key: "ciudadano", short: "Ciudadano", label: "Soy ciudadano", icon: "home" },
  { href: "/autoridad", key: "autoridad", short: "Autoridad", label: "Soy autoridad de salud", icon: "hospital" },
  { href: "/plan", key: "plan", short: "Plan", label: "Plan de acción", icon: "target" },
  { href: "/impacto", key: "impacto", short: "Alimentos", label: "Alimentos y suministros", icon: "droplet" },
  { href: "/nino-2027", key: "nino2027", short: "2027", label: "Qué viene en 2027", icon: "wave" },
  { href: "/modelo", key: "modelo", short: "Cómo funciona", label: "Cómo funciona el modelo", icon: "cpu" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#1c5cab" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1a19" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Salud Niño" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title} · Alerta Salud Niño</title>
    <script is:inline>
      // Aplica el tema guardado antes de pintar, para evitar el parpadeo
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
        const z = localStorage.getItem("text-size");
        if (z === "lg" || z === "xl") document.documentElement.dataset.size = z;
      } catch {}
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <header class="topbar">
      <a href="/" class="brand" aria-label="Alerta Salud Niño, inicio">
        <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="15" fill="var(--brand)" />
          <path d="M16 7c-4 5-6 8.5-6 11.5a6 6 0 0 0 12 0C22 15.5 20 12 16 7z" fill="#fff" />
          <path d="M13 18.5h6M16 15.5v6" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span>Alerta Salud <strong>Niño</strong></span>
      </a>
      <nav id="main-nav" class="main-nav" aria-label="Principal">
        {nav.map((item) => (
          <a href={item.href} class:list={[{ active: active === item.key }]} aria-current={active === item.key ? "page" : undefined} title={item.label}>
            <Fragment set:html={icon(item.icon, 18)} />
            <span class="lbl-short" aria-hidden="true">{item.short}</span>
            <span class="lbl-long">{item.label}</span>
          </a>
        ))}
      </nav>
      <div class="tools">
        <button type="button" id="install-btn" class="install-btn" hidden title="Instalar la app en tu celular">
          <Fragment set:html={icon("smartphone", 18)} /><span>Instalar app</span>
        </button>
        <button type="button" id="size-toggle" class="theme-toggle" aria-label="Tamaño del texto: normal" title="Tamaño del texto">
          <Fragment set:html={icon("textSize", 18)} />
        </button>
        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar entre modo claro y oscuro" title="Modo claro / oscuro">
          <span class="ico-sun"><Fragment set:html={icon("sun", 18)} /></span>
          <span class="ico-moon"><Fragment set:html={icon("moon", 18)} /></span>
        </button>
        <button type="button" id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Abrir el menú">
          <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
      </div>
    </header>
    <div class="menu-backdrop" id="menu-backdrop" hidden></div>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <dialog id="help-dialog" class="help-dialog" aria-labelledby="help-title">
      <form method="dialog">
        <p class="eyebrow">¿Qué significa?</p>
        <h2 id="help-title"></h2>
        <p id="help-que"></p>
        <p id="help-leer" class="help-block" hidden></p>
        <p id="help-ojo" class="help-block warn" hidden></p>
        <div class="help-actions">
          <button class="btn primary" value="ok">Entendido</button>
        </div>
      </form>
    </dialog>
    <dialog id="install-dialog" class="install-dialog" aria-labelledby="install-title">
      <form method="dialog">
        <h2 id="install-title" class="inline-ico"><Fragment set:html={icon("smartphone", 22)} /> Instala la app en tu celular</h2>
        <p class="muted small">Se abre como una app, muestra los últimos datos aunque no tengas internet y puede avisarte cuando suba el riesgo en tu distrito.</p>
        <section>
          <h3 class="inline-ico"><Fragment set:html={icon("share", 18)} /> iPhone (Safari)</h3>
          <ol class="small">
            <li>Toca el botón <strong>Compartir</strong>, el cuadrado con una flecha hacia arriba.</li>
            <li>Elige <strong>Agregar a inicio</strong>.</li>
            <li>Abre la app desde tu pantalla de inicio.</li>
          </ol>
        </section>
        <section>
          <h3 class="inline-ico"><Fragment set:html={icon("smartphone", 18)} /> Android (Chrome o Samsung Internet)</h3>
          <ol class="small">
            <li>Abre el menú del navegador (los tres puntos).</li>
            <li>Elige <strong>Instalar app</strong> o <strong>Agregar a pantalla de inicio</strong>.</li>
          </ol>
        </section>
        <button class="btn primary" value="ok">Entendido</button>
      </form>
    </dialog>
    <button type="button" class="to-top" id="to-top" aria-label="Volver arriba" title="Volver arriba"><Fragment set:html={icon("arrowRight", 20)} /></button>
    <footer class="footer">
      <div class="foot-grid">
        <section class="foot-brand">
          <strong>Alerta Salud <span>Niño</span></strong>
          <p>Alertas tempranas de dengue y enfermedades asociadas a El Niño costero para {app.distritos.length} distritos de Tumbes, Piura y Lambayeque. Prototipo del Hackathon ISIL 2026.</p>
          <button type="button" class="btn primary" data-open-demo><Fragment set:html={icon("sparkles", 18)} /> Ver la demo guiada</button>
        </section>
        <nav class="foot-col" aria-label="Producto">
          <h2>Producto</h2>
          <a href="/ciudadano">Soy ciudadano</a>
          <a href="/autoridad">Autoridad de salud</a>
          <a href="/plan">Plan de acción</a>
          <a href="/impacto">Alimentos y suministros</a>
          <a href="/nino-2027">Qué viene en 2027</a>
        </nav>
        <nav class="foot-col" aria-label="Proyecto">
          <h2>El proyecto</h2>
          <a href="/modelo">Cómo funciona el modelo</a>
          <a href="/construccion">Cómo se construyó</a>
          <a href="https://github.com/MarxAlonso/hackaton-samsung" target="_blank" rel="noopener">Código en GitHub</a>
        </nav>
        <section class="foot-col" aria-label="Estado de los datos">
          <h2>Estado de los datos</h2>
          <p><span class="foot-k">Último caso oficial</span> {fechaCorta(app.datos.ultimo_caso_oficial)}</p>
          <p><span class="foot-k">Semana de la predicción</span> {fechaCorta(app.escenarios.actual.semana)}</p>
          <p><span class="foot-k">Datos generados</span> {app.generado.slice(0, 10).split("-").reverse().join("/")}</p>
        </section>
      </div>
      <p class="foot-legal">
        Clima real (Open-Meteo, NOAA). Casos <strong>reales</strong> de dengue, diarreas, infecciones respiratorias y leptospirosis del CDC-MINSA
        (Plataforma Nacional de Datos Abiertos, ODC-By); golpe de calor <strong>simulado</strong>. Apoyo a la decisión: no reemplaza la consulta
        médica ni los comunicados oficiales del MINSA y el ENFEN.
      </p>
    </footer>
    <script is:inline id="glosario-data" type="application/json" set:html={JSON.stringify(GLOSARIO)} />
    <script>
      import { initPwa } from "../lib/pwa";
      import { initMotion } from "../lib/motion";
      initPwa();
      initMotion();

      // La demo guiada se abre en una ventana aparte (si el navegador la bloquea, se abre en esta misma)
      document.querySelectorAll<HTMLElement>("[data-open-demo]").forEach((el) =>
        el.addEventListener("click", (e) => {
          e.preventDefault();
          const w = Math.min(1360, screen.availWidth), h = Math.min(900, screen.availHeight);
          const win = window.open("/demo/", "demo-guiada", `popup=yes,width=${w},height=${h},left=${Math.max(0, (screen.availWidth - w) / 2)},top=${Math.max(0, (screen.availHeight - h) / 2)}`);
          if (!win) location.href = "/demo/";
          else win.focus();
        }),
      );

      // Menú del celular: se abre con el botón, se cierra con un enlace, con Esc, tocando fuera o al pasar a escritorio
      const topbar = document.querySelector<HTMLElement>(".topbar")!;
      const menuBtn = document.getElementById("menu-toggle")!;
      const backdrop = document.getElementById("menu-backdrop")!;
      const setMenu = (open: boolean) => {
        topbar.classList.toggle("open", open);
        document.body.classList.toggle("menu-open", open);
        menuBtn.setAttribute("aria-expanded", String(open));
        menuBtn.setAttribute("aria-label", open ? "Cerrar el menú" : "Abrir el menú");
        backdrop.hidden = !open;
        if (open) document.querySelector<HTMLElement>("#main-nav a")?.focus({ preventScroll: true });
      };
      menuBtn.addEventListener("click", () => setMenu(!topbar.classList.contains("open")));
      backdrop.addEventListener("click", () => setMenu(false));
      document.querySelectorAll("#main-nav a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
      addEventListener("keydown", (e) => { if (e.key === "Escape" && topbar.classList.contains("open")) { setMenu(false); menuBtn.focus(); } });
      matchMedia("(min-width: 981px)").addEventListener("change", (e) => { if (e.matches) setMenu(false); });

      const toTop = document.getElementById("to-top")!;
      const progress = document.querySelector<HTMLElement>(".scroll-progress")!;
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        progress.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
        toTop.classList.toggle("show", scrollY > 500);
      };
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      toTop.addEventListener("click", () => scrollTo({ top: 0, behavior: "smooth" }));

      // Botones «?»: una sola ventana de ayuda para todo el sitio (el texto sale de src/lib/glossary.ts)
      const GLOSARIO_JSON = JSON.parse(document.getElementById("glosario-data")!.textContent!) as Record<string, { titulo: string; que: string; leer?: string; ojo?: string }>;
      const helpDialog = document.getElementById("help-dialog") as HTMLDialogElement;
      document.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>("[data-help]");
        if (!b) return;
        e.preventDefault();   // dentro de un apartado, el «?» no debe abrirlo ni cerrarlo
        e.stopPropagation();
        const entry = GLOSARIO_JSON[b.dataset.help!];
        if (!entry) return;
        document.getElementById("help-title")!.textContent = entry.titulo;
        document.getElementById("help-que")!.textContent = entry.que;
        for (const [id, label, text] of [["help-leer", "Cómo leerlo. ", entry.leer], ["help-ojo", "Ojo. ", entry.ojo]] as const) {
          const p = document.getElementById(id)!;
          p.hidden = !text;
          p.textContent = "";
          if (text) { const s = document.createElement("strong"); s.textContent = label; p.append(s, text); }
        }
        helpDialog.showModal();
      }, true);
      helpDialog.addEventListener("click", (e) => { if (e.target === helpDialog) helpDialog.close(); });

      // Al imprimir se abren todos los apartados para que el papel lleve todo
      addEventListener("beforeprint", () => document.querySelectorAll<HTMLDetailsElement>("details.acc").forEach((d) => (d.open = true)));

      // Texto grande: normal → grande → muy grande (se recuerda en este navegador)
      const sizeBtn = document.getElementById("size-toggle")!;
      const SIZES = [["", "normal"], ["lg", "grande"], ["xl", "muy grande"]] as const;
      const syncSize = () => {
        const cur = document.documentElement.dataset.size ?? "";
        const label = SIZES.find(([k]) => k === cur)?.[1] ?? "normal";
        sizeBtn.setAttribute("aria-label", `Tamaño del texto: ${label}. Toca para cambiarlo`);
        sizeBtn.title = `Tamaño del texto: ${label}`;
        sizeBtn.classList.toggle("on", cur !== "");
      };
      sizeBtn.addEventListener("click", () => {
        const cur = document.documentElement.dataset.size ?? "";
        const next = SIZES[(SIZES.findIndex(([k]) => k === cur) + 1) % SIZES.length][0];
        if (next) document.documentElement.dataset.size = next; else delete document.documentElement.dataset.size;
        try { next ? localStorage.setItem("text-size", next) : localStorage.removeItem("text-size"); } catch {}
        syncSize();
      });
      syncSize();

      const btn = document.getElementById("theme-toggle")!;
      const root = document.documentElement;
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
      const current = () => root.dataset.theme ?? (prefersDark.matches ? "dark" : "light");
      btn.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        window.dispatchEvent(new CustomEvent("themechange", { detail: next }));
      });
    </script>
  </body>
</html>
