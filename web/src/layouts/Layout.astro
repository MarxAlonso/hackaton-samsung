---
import "../styles/global.css";
import { icon } from "../lib/icons";
import app from "../../public/data/app.json";

interface Props {
  title: string;
  description?: string;
  active?: "inicio" | "ciudadano" | "autoridad" | "plan" | "modelo";
  wide?: boolean;
}
const { title, description = "Alertas tempranas de dengue y enfermedades asociadas a El Niño por distrito.", active, wide = false } = Astro.props;
const fechaCorta = (iso: string) => new Date(iso + "T12:00:00").toLocaleDateString("es-PE", { day: "numeric", month: "short", year: "numeric" });
const nav = [
  { href: "/ciudadano", key: "ciudadano", label: "Soy ciudadano", icon: "home" },
  { href: "/autoridad", key: "autoridad", label: "Soy autoridad de salud", icon: "hospital" },
  { href: "/plan", key: "plan", label: "Plan de acción", icon: "target" },
  { href: "/modelo", key: "modelo", label: "Cómo funciona", icon: "cpu" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#1c5cab" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1a19" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Salud Niño" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title} · Alerta Salud Niño</title>
    <script is:inline>
      // Aplica el tema guardado antes de pintar, para evitar el parpadeo
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <header class="topbar">
      <a href="/" class="brand" aria-label="Alerta Salud Niño, inicio">
        <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="15" fill="var(--brand)" />
          <path d="M16 7c-4 5-6 8.5-6 11.5a6 6 0 0 0 12 0C22 15.5 20 12 16 7z" fill="#fff" />
          <path d="M13 18.5h6M16 15.5v6" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span>Alerta Salud <strong>Niño</strong></span>
      </a>
      <nav aria-label="Principal">
        {nav.map((item) => (
          <a href={item.href} class:list={[{ active: active === item.key }]} aria-current={active === item.key ? "page" : undefined} aria-label={item.label} title={item.label}>
            <Fragment set:html={icon(item.icon, 18)} />
            <span>{item.label}</span>
          </a>
        ))}
        <button type="button" id="install-btn" class="install-btn" hidden title="Instalar la app en tu celular">
          <Fragment set:html={icon("smartphone", 18)} /><span>Instalar app</span>
        </button>
        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar entre modo claro y oscuro" title="Modo claro / oscuro">
          <span class="ico-sun"><Fragment set:html={icon("sun", 18)} /></span>
          <span class="ico-moon"><Fragment set:html={icon("moon", 18)} /></span>
        </button>
      </nav>
    </header>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <dialog id="install-dialog" class="install-dialog" aria-labelledby="install-title">
      <form method="dialog">
        <h2 id="install-title" class="inline-ico"><Fragment set:html={icon("smartphone", 22)} /> Instala la app en tu celular</h2>
        <p class="muted small">Se abre como una app, muestra los últimos datos aunque no tengas internet y puede avisarte cuando suba el riesgo en tu distrito.</p>
        <section>
          <h3 class="inline-ico"><Fragment set:html={icon("share", 18)} /> iPhone (Safari)</h3>
          <ol class="small">
            <li>Toca el botón <strong>Compartir</strong>, el cuadrado con una flecha hacia arriba.</li>
            <li>Elige <strong>Agregar a inicio</strong>.</li>
            <li>Abre la app desde tu pantalla de inicio.</li>
          </ol>
        </section>
        <section>
          <h3 class="inline-ico"><Fragment set:html={icon("smartphone", 18)} /> Android (Chrome o Samsung Internet)</h3>
          <ol class="small">
            <li>Abre el menú del navegador (los tres puntos).</li>
            <li>Elige <strong>Instalar app</strong> o <strong>Agregar a pantalla de inicio</strong>.</li>
          </ol>
        </section>
        <button class="btn primary" value="ok">Entendido</button>
      </form>
    </dialog>
    <button type="button" class="to-top" id="to-top" aria-label="Volver arriba" title="Volver arriba"><Fragment set:html={icon("arrowRight", 20)} /></button>
    <footer class="footer">
      <div class="foot-grid">
        <section class="foot-brand">
          <strong>Alerta Salud <span>Niño</span></strong>
          <p>Alertas tempranas de dengue y enfermedades asociadas a El Niño costero para {app.distritos.length} distritos de Tumbes, Piura y Lambayeque. Prototipo del Hackathon ISIL 2026.</p>
          <button type="button" class="btn primary" data-open-demo><Fragment set:html={icon("sparkles", 18)} /> Ver la demo guiada</button>
        </section>
        <nav class="foot-col" aria-label="Producto">
          <h2>Producto</h2>
          <a href="/ciudadano">Soy ciudadano</a>
          <a href="/autoridad">Soy autoridad de salud</a>
          <a href="/plan">Plan de acción</a>
        </nav>
        <nav class="foot-col" aria-label="Proyecto">
          <h2>El proyecto</h2>
          <a href="/modelo">Cómo funciona el modelo</a>
          <a href="/construccion">Cómo se construyó</a>
          <a href="https://github.com/MarxAlonso/hackaton-samsung" target="_blank" rel="noopener">Código en GitHub</a>
        </nav>
        <section class="foot-col" aria-label="Estado de los datos">
          <h2>Estado de los datos</h2>
          <p><span class="foot-k">Último caso oficial</span> {fechaCorta(app.datos.ultimo_caso_oficial)}</p>
          <p><span class="foot-k">Semana de la predicción</span> {fechaCorta(app.escenarios.actual.semana)}</p>
          <p><span class="foot-k">Datos generados</span> {app.generado.slice(0, 10).split("-").reverse().join("/")}</p>
        </section>
      </div>
      <p class="foot-legal">
        Clima real (Open-Meteo, NOAA). Casos <strong>reales</strong> de dengue, diarreas, infecciones respiratorias y leptospirosis del CDC-MINSA
        (Plataforma Nacional de Datos Abiertos, ODC-By); golpe de calor <strong>simulado</strong>. Apoyo a la decisión: no reemplaza la consulta
        médica ni los comunicados oficiales del MINSA y el ENFEN.
      </p>
    </footer>
    <script>
      import { initPwa } from "../lib/pwa";
      initPwa();

      // La demo guiada se abre en una ventana aparte (si el navegador la bloquea, se abre en esta misma)
      document.querySelectorAll<HTMLElement>("[data-open-demo]").forEach((el) =>
        el.addEventListener("click", (e) => {
          e.preventDefault();
          const w = Math.min(1360, screen.availWidth), h = Math.min(900, screen.availHeight);
          const win = window.open("/demo/", "demo-guiada", `popup=yes,width=${w},height=${h},left=${Math.max(0, (screen.availWidth - w) / 2)},top=${Math.max(0, (screen.availHeight - h) / 2)}`);
          if (!win) location.href = "/demo/";
          else win.focus();
        }),
      );

      const toTop = document.getElementById("to-top")!;
      const progress = document.querySelector<HTMLElement>(".scroll-progress")!;
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        progress.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
        toTop.classList.toggle("show", scrollY > 500);
      };
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      toTop.addEventListener("click", () => scrollTo({ top: 0, behavior: "smooth" }));

      const btn = document.getElementById("theme-toggle")!;
      const root = document.documentElement;
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
      const current = () => root.dataset.theme ?? (prefersDark.matches ? "dark" : "light");
      btn.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        window.dispatchEvent(new CustomEvent("themechange", { detail: next }));
      });
    </script>
  </body>
</html>
