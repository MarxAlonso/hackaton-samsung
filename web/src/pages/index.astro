---
import Layout from "../layouts/Layout.astro";
import app from "../../public/data/app.json";
import { icon } from "../lib/icons";

const actual = app.escenarios.actual;
const altos = actual.distritos.filter((d) => d.riesgos.dengue.nivel === "alto").length;
const medios = actual.distritos.filter((d) => d.riesgos.dengue.nivel === "medio").length;
const semana = new Date(actual.semana + "T12:00:00").toLocaleDateString("es-PE", { day: "numeric", month: "long", year: "numeric" });
const nino = actual.nino12;
const poblacion = app.distritos.reduce((a: number, d: any) => a + d.population, 0);
// Replay de 2023: el sistema con un modelo entrenado solo hasta 2021 y los casos reales del CDC-MINSA
const r23: any = app.escenarios["2023"];
const conReal = r23.distritos.filter((p: any) => p.real);
const aciertos = conReal.filter((p: any) => (p.riesgos.dengue.prob >= 0.5) === p.real.brote).length;
const previstos = conReal.reduce((a: number, p: any) => a + p.riesgos.dengue.casos_p50, 0);
const reales = conReal.reduce((a: number, p: any) => a + p.real.casos_4_semanas, 0);
const enRango = conReal.filter((p: any) => p.real.casos_4_semanas >= p.riesgos.dengue.casos_p10 && p.real.casos_4_semanas <= p.riesgos.dengue.casos_p90).length;
const semana23 = new Date(r23.semana + "T12:00:00").toLocaleDateString("es-PE", { day: "numeric", month: "long", year: "numeric" });
const nf = (v: number) => Math.round(v).toLocaleString("es-PE");
const fecha = (iso: string) => new Date(iso + "T12:00:00").toLocaleDateString("es-PE", { day: "numeric", month: "short", year: "numeric" });
// Qué viene en 2027 (NOAA)
const n27: any = (app as any).nino_2027;
const temporadas: any[] = n27?.probabilidades_oficiales?.temporadas ?? [];
// La temporada que importa para la costa norte es el verano (diciembre a febrero); si no está, la de mayor probabilidad
const peakSeason = temporadas.find((t: any) => t.temporada === "DJF") ?? temporadas.reduce((a: any, t: any) => (t.el_nino_por_fuerza_pct.muy_fuerte > (a?.el_nino_por_fuerza_pct.muy_fuerte ?? -1) ? t : a), null);
const hist = n27?.discusion?.evento_historico;
const histMax = hist ? Math.max(...(Object.values(hist.probabilidades_pct) as number[])) : null;
const cdc: any = (app as any).dengue_2026_cdc;
const casos26 = cdc ? Object.values(cdc.departamentos as Record<string, any>).reduce((a: number, d: any) => a + d.casos_2026, 0) : null;
---

<Layout title="Inicio" active="inicio">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
    </div>
    <div class="hero-text" data-reveal>
      <p class="eyebrow pill"><Fragment set:html={icon("pin", 14)} /> Tumbes · Piura · Lambayeque · {app.distritos.length} distritos · {nf(poblacion / 1e6 * 10) / 10 >= 1 ? `${(poblacion / 1e6).toFixed(1).replace(".", ",")} millones de personas` : `${nf(poblacion)} personas`}</p>
      <h1>El Niño costero ya está aquí.<br /><span class="grad">Anticipa el dengue</span> antes de que llegue.</h1>
      <p class="lead muted">
        Juntamos la lluvia, el calor y la temperatura del mar con los casos reales del MINSA para avisar, hasta <strong>4 semanas antes</strong>,
        en qué distritos del norte puede haber brotes de dengue y otras enfermedades. Para que las familias se protejan y las postas se preparen a tiempo.
      </p>
      <div class="cta">
        <a class="btn primary" href="/ciudadano"><Fragment set:html={icon("home", 18)} /> Ver mi distrito</a>
        <a class="btn" href="/autoridad"><Fragment set:html={icon("hospital", 18)} /> Panel de autoridad</a>
        <button type="button" class="btn ghost" data-open-demo><Fragment set:html={icon("sparkles", 18)} /> Demo guiada</button>
      </div>
      <ul class="trust small">
        <li><Fragment set:html={icon("checkCircle", 16)} /> Casos reales del CDC-MINSA</li>
        <li><Fragment set:html={icon("checkCircle", 16)} /> Clima de Open-Meteo y NOAA</li>
        <li><Fragment set:html={icon("checkCircle", 16)} /> Gratis, abierto y sin datos personales</li>
      </ul>
    </div>

    <!-- Ilustración animada: del mar caliente a la alerta -->
    <div class="hero-art-wrap" data-reveal="120">
    <svg class="hero-art" viewBox="0 0 420 300" role="img" aria-label="Diagrama: el mar se calienta, llueve más, se forman criaderos y suben los casos; el sistema alerta antes">
      <defs>
        <linearGradient id="sea" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--series-2)" stop-opacity=".92"/><stop offset="1" stop-color="var(--series-1)" stop-opacity=".92"/></linearGradient>
        <linearGradient id="sky" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--brand-soft)"/><stop offset="1" stop-color="var(--surface)"/></linearGradient>
        <radialGradient id="glow"><stop offset="0" stop-color="var(--warning)" stop-opacity=".55"/><stop offset="1" stop-color="var(--warning)" stop-opacity="0"/></radialGradient>
        <clipPath id="frame"><rect x="0" y="0" width="420" height="300" rx="20"/></clipPath>
      </defs>
      <rect x="0" y="0" width="420" height="300" rx="20" fill="url(#sky)" stroke="var(--border)"/>
      <g clip-path="url(#frame)">
        <!-- mar: dos capas de olas que se desplazan -->
        <g class="wave w1"><path d="M-420 232 Q -385 214 -350 232 T -280 232 T -210 232 T -140 232 T -70 232 T 0 232 T 70 232 T 140 232 T 210 232 T 280 232 T 350 232 T 420 232 T 490 232 T 560 232 T 630 232 T 700 232 T 770 232 T 840 232 V 300 H -420 Z" fill="url(#sea)"/></g>
        <g class="wave w2"><path d="M-420 252 Q -385 238 -350 252 T -280 252 T -210 252 T -140 252 T -70 252 T 0 252 T 70 252 T 140 252 T 210 252 T 280 252 T 350 252 T 420 252 T 490 252 T 560 252 T 630 252 T 700 252 T 770 252 T 840 252" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="2"/></g>
      </g>
      <g transform="translate(26 246)" fill="#fff" font-size="11" font-weight="700" font-family="inherit">
        <text y="20">Mar +{nino.toFixed(1)} °C</text>
        <text y="34" font-weight="400" opacity=".9">Niño 1+2 · NOAA</text>
      </g>
      <!-- sol con halo que respira -->
      <circle class="halo" cx="356" cy="60" r="48" fill="url(#glow)"/>
      <circle cx="356" cy="60" r="26" fill="var(--warning)" opacity=".92"/>
      <g class="rays" stroke="var(--warning)" stroke-width="3" stroke-linecap="round" opacity=".8">
        <path d="M356 18v10M356 92v10M314 60h10M388 60h10M326 30l7 7M379 83l7 7M326 90l7-7M379 37l7-7"/>
      </g>
      <!-- nube que flota y lluvia que cae -->
      <g class="cloud" transform="translate(110 40)">
        <path d="M30 70a22 22 0 0 1 4-43 30 30 0 0 1 57 6 20 20 0 0 1 3 40z" fill="var(--surface)" stroke="var(--text-3)" stroke-width="2"/>
        <g class="rain" stroke="var(--series-1)" stroke-width="3" stroke-linecap="round">
          <path d="M34 84l-6 16"/><path d="M56 84l-6 16" style="animation-delay:.35s"/><path d="M78 84l-6 16" style="animation-delay:.7s"/><path d="M45 100l-6 14" style="animation-delay:.5s"/><path d="M67 100l-6 14" style="animation-delay:.15s"/>
        </g>
      </g>
      <!-- balde con agua + zancudo -->
      <g transform="translate(220 150)">
        <path d="M8 10h52l-6 46H14z" fill="var(--surface-3)" stroke="var(--text-2)" stroke-width="2"/>
        <path d="M14 22h40" stroke="var(--series-1)" stroke-width="4" stroke-linecap="round"/>
        <g class="mosquito" transform="translate(60 -20) scale(1.3)" fill="none" stroke="var(--text)" stroke-width="1.7" stroke-linecap="round">
          <ellipse cx="12" cy="13" rx="2.2" ry="5" fill="var(--text)"/><circle cx="12" cy="6.5" r="1.6" fill="var(--text)"/>
          <path d="M12 5l-2-3M12 5l2-3M10 11L4 8M14 11l6-3M10 14l-5 3M14 14l5 3M11 18l-2 4M13 18l2 4"/>
        </g>
      </g>
      <!-- flechas del proceso -->
      <g class="flow" fill="none" stroke="var(--text-2)" stroke-width="2" stroke-dasharray="4 4">
        <path d="M175 160q25 20 45 20"/><path d="M80 230q30-50 60-70" />
      </g>
      <!-- tarjeta de alerta -->
      <g class="alert-card" transform="translate(300 170)">
        <rect x="0" y="0" width="104" height="62" rx="10" fill="var(--surface)" stroke="var(--critical)" stroke-width="2"/>
        <circle class="dot-alert" cx="18" cy="18" r="7" fill="var(--critical)"/>
        <text x="32" y="22" font-size="11" font-weight="700" fill="var(--text)" font-family="inherit">Riesgo alto</text>
        <text x="10" y="42" font-size="10" fill="var(--text-2)" font-family="inherit">brote en 4 semanas</text>
        <text x="10" y="55" font-size="10" fill="var(--text-2)" font-family="inherit">y su confianza</text>
      </g>
    </svg>
    </div>
  </section>

  <section class="status card" role="status" data-reveal>
    <div>
      <span class="ico-box brand"><Fragment set:html={icon("wave", 22)} /></span>
      <div><span class="eyebrow">Mar frente a Piura y Tumbes</span><strong class="big"><span data-count={nino.toFixed(1)} data-dec="1" data-prefix={nino > 0 ? "+" : ""} data-suffix=" °C">{nino > 0 ? "+" : ""}{nino.toFixed(1).replace(".", ",")} °C</span></strong><span class="muted small">sobre lo normal · NOAA, semana del {semana}</span></div>
    </div>
    <div>
      <span class="ico-box brand"><Fragment set:html={icon("mosquito", 22)} /></span>
      <div><span class="eyebrow">Distritos en riesgo de dengue</span><strong class="big"><span data-count={altos}>{altos}</span> alto · <span data-count={medios}>{medios}</span> medio</strong><span class="muted small">próximas 4 semanas</span></div>
    </div>
    {casos26 != null && (
      <div>
        <span class="ico-box brand"><Fragment set:html={icon("activity", 22)} /></span>
        <div><span class="eyebrow">Casos de dengue en 2026</span><strong class="big"><span data-count={casos26}>{nf(casos26)}</span></strong><span class="muted small">en los tres departamentos, hasta la semana {cdc.meta.semana_epidemiologica} (CDC)</span></div>
      </div>
    )}
    <div>
      <span class="ico-box brand"><Fragment set:html={icon("calendar", 22)} /></span>
      <div><span class="eyebrow">Época de mayor riesgo</span><strong class="big">Enero – mayo</strong><span class="muted small">el ENFEN prevé que El Niño costero dure hasta el verano de 2027</span></div>
    </div>
  </section>

  {n27 && peakSeason && (
    <section class="card nino27" data-reveal>
      <div class="nino27-text">
        <p class="eyebrow"><Fragment set:html={icon("wave", 14)} /> Qué viene en 2027</p>
        <h2>NOAA da <span class="grad">{peakSeason.el_nino_por_fuerza_pct.muy_fuerte}%</span> de probabilidad a un El Niño <em>muy fuerte</em> en el verano ({peakSeason.etiqueta}){histMax ? `, y ${histMax}% de que sea el más fuerte desde 1950` : ""}.</h2>
        <p class="muted">El mar frente a Perú ya está <strong>+{(n27.discusion?.indices_ultimo_mes_C?.nino12 ?? nino).toFixed(1).replace(".", ",")} °C</strong> sobre lo normal. Las lluvias del verano llegarán con el mar caliente: es ahora cuando se prepara.</p>
        <a class="btn primary" href="/nino-2027">Ver el pronóstico completo <Fragment set:html={icon("arrowRight", 16)} /></a>
      </div>
      <ol class="mini-bars" aria-label="Probabilidad de El Niño muy fuerte por temporada">
        {temporadas.slice(0, 8).map((t: any) => (
          <li>
            <span class="mb-bar"><i style={`height:${Math.max(4, t.el_nino_por_fuerza_pct.muy_fuerte + t.el_nino_por_fuerza_pct.fuerte)}%`} class={t === peakSeason ? "peak" : ""}></i></span>
            <span class="mb-label">{t.temporada}</span>
            <span class="mb-val small muted">{t.el_nino_por_fuerza_pct.muy_fuerte + t.el_nino_por_fuerza_pct.fuerte}%</span>
          </li>
        ))}
      </ol>
      <p class="small muted mb-note">Barras: probabilidad de El Niño fuerte o muy fuerte por temporada de 3 meses, según NOAA (región Niño 3.4). Fuente y detalle en la página.</p>
    </section>
  )}

  <section class="impact card" aria-labelledby="impact-title" data-reveal>
    <p class="eyebrow">¿Habría servido en 2023?</p>
    <h2 id="impact-title">Con el sistema, 3 semanas antes del pico de dengue de 2023 la alerta acertó en <span class="grad">{aciertos} de {conReal.length}</span> distritos</h2>
    <p class="muted">Volvemos a la semana del {semana23}, con un modelo entrenado <strong>solo con datos hasta 2021</strong> (nunca vio esa epidemia) y comparamos con los casos reales del CDC-MINSA.</p>
    <ul class="impact-grid">
      <li data-reveal="0"><strong><span data-count={aciertos}>{aciertos}</span> de {conReal.length}</strong><span>distritos bien clasificados: ¿habría brote en las próximas 4 semanas, sí o no?</span></li>
      <li data-reveal="100"><strong><span data-count={previstos}>{nf(previstos)}</span> frente a {nf(reales)}</strong><span>casos previstos frente a los que hubo en las 4 semanas siguientes</span></li>
      <li data-reveal="200"><strong><span data-count={enRango}>{enRango}</span> de {conReal.length}</strong><span>distritos donde los casos reales cayeron dentro del rango previsto</span></li>
    </ul>
    <div class="cta">
      <a class="btn primary" href="/autoridad?escenario=2023"><Fragment set:html={icon("calendar", 18)} /> Ver el replay distrito por distrito</a>
      <a class="btn" href="/modelo"><Fragment set:html={icon("shield", 18)} /> Ver también dónde falla</a>
    </div>
    <p class="small muted">Con casos recientes el modelo funciona así de bien. Hoy no hay casos oficiales recientes por distrito: la estimación de hoy usa solo clima, se ajusta con el acumulado oficial del CDC y es menos precisa (lo decimos en cada pantalla).</p>
  </section>

  <section class="choices" aria-label="Elige tu perfil">
    <a class="choice card" href="/ciudadano" data-reveal="0">
      <span class="ico-box brand"><Fragment set:html={icon("home", 24)} /></span>
      <h2>Soy ciudadano</h2>
      <p class="muted">Elige tu distrito y mira, como un semáforo, los 3 riesgos principales y qué hacer en casa. Escúchalo en voz alta o actívate alertas en el celular.</p>
      <span class="btn primary">Ver mi distrito <Fragment set:html={icon("arrowRight", 16)} /></span>
    </a>
    <a class="choice card" href="/autoridad" data-reveal="100">
      <span class="ico-box brand"><Fragment set:html={icon("hospital", 24)} /></span>
      <h2>Soy autoridad de salud</h2>
      <p class="muted">Distritos priorizados, casos esperados, casos 2026 del CDC, mapa de lluvias extremas, simulador y plan de brigadas con su impacto económico.</p>
      <span class="btn primary">Abrir panel <Fragment set:html={icon("arrowRight", 16)} /></span>
    </a>
    <a class="choice card" href="/impacto" data-reveal="200">
      <span class="ico-box brand"><Fragment set:html={icon("droplet", 24)} /></span>
      <h2>Alimentos y suministros</h2>
      <p class="muted">Qué puede afectar El Niño en cada distrito: agua, pruebas rápidas, camas, brigadas, y los cultivos de la costa norte en riesgo.</p>
      <span class="btn primary">Ver el panel <Fragment set:html={icon("arrowRight", 16)} /></span>
    </a>
  </section>

  <section class="health" aria-label="Estado del sistema" data-reveal>
    <span class="eyebrow">Estado del sistema</span>
    <ul>
      <li><i class="dot ok"></i><span>Clima y pronóstico hasta <strong>{fecha(actual.ventana_lluvia.hasta)}</strong></span></li>
      <li><i class={`dot ${actual.modelo.familia === "casos" ? "ok" : "warn"}`}></i><span>Último caso oficial por distrito (CDC-MINSA): <strong>{fecha(app.datos.ultimo_caso_oficial)}</strong>{actual.modelo.familia === "clima" ? " · hoy se estima con clima y se ajusta con el acumulado del CDC" : ""}</span></li>
      <li><i class="dot ok"></i><span>Modelo reentrenado cada lunes · datos generados el <strong>{app.generado.slice(0, 10).split("-").reverse().join("/")}</strong></span></li>
      <li><a href="/construccion/#estado">Ver el detalle</a></li>
    </ul>
  </section>

  <section class="steps" data-reveal>
    <h2>Cómo funciona</h2>
    <ol>
      <li class="card lift"><span class="ico-box brand"><Fragment set:html={icon("database", 22)} /></span><div><strong>1. Datos reales</strong><p class="muted small">Casos del CDC-MINSA, lluvia y temperatura de cada distrito (Open-Meteo) y el mar frente a Perú (NOAA), actualizados solos cada semana.</p></div></li>
      <li class="card lift"><span class="ico-box brand"><Fragment set:html={icon("cpu", 22)} /></span><div><strong>2. El modelo predice</strong><p class="muted small">Un modelo entrenado en Python calcula la probabilidad de brote y un rango de casos, con su nivel de confianza, y dice cuándo no está seguro.</p></div></li>
      <li class="card lift"><span class="ico-box brand"><Fragment set:html={icon("user", 22)} /></span><div><strong>3. Tú decides</strong><p class="muted small">Se traduce en acciones concretas: fumigar, abastecer pruebas, enviar brigadas o, en casa, eliminar criaderos.</p></div></li>
    </ol>
    <p><a href="/construccion" class="inline-ico">Cómo se construyó, con qué datos y qué no sabe <Fragment set:html={icon("arrowRight", 16)} /></a></p>
  </section>
</Layout>

<style>
  .hero { position: relative; display: grid; grid-template-columns: 1.15fr 1fr; gap: 28px; align-items: center; padding: 22px 0 28px; isolation: isolate; }
  .hero-bg { position: absolute; inset: -40px -20px 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.45; }
  .b1 { width: 420px; height: 420px; left: -120px; top: -80px; background: var(--brand-soft); animation: drift 14s ease-in-out infinite; }
  .b2 { width: 360px; height: 360px; right: -60px; top: 10px; background: color-mix(in srgb, var(--warning) 40%, transparent); animation: drift 18s ease-in-out infinite reverse; }
  .b3 { width: 300px; height: 300px; left: 40%; bottom: -120px; background: color-mix(in srgb, var(--series-3) 35%, transparent); animation: drift 22s ease-in-out infinite; }
  @keyframes drift { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(24px, -18px); } }
  .pill { display: inline-flex; align-items: center; gap: 6px; background: var(--surface); border: 1px solid var(--border); padding: 6px 12px; border-radius: 999px; margin-bottom: 14px; }
  .grad { background: linear-gradient(90deg, var(--brand), var(--series-3)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { font-size: 1.12rem; max-width: 640px; line-height: 1.6; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .btn.ghost { background: transparent; }
  .trust { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px 18px; color: var(--text-2); }
  .trust li { display: inline-flex; align-items: center; gap: 6px; }
  .trust svg { color: var(--series-3); }
  .hero-art-wrap { filter: drop-shadow(0 18px 30px rgba(28, 92, 171, 0.14)); }
  .hero-art { width: 100%; height: auto; }
  .wave path { animation: wave 9s linear infinite; }
  .wave.w2 path { animation-duration: 13s; animation-direction: reverse; }
  @keyframes wave { from { transform: translateX(0); } to { transform: translateX(-420px); } }
  .halo { animation: breathe 4s ease-in-out infinite; transform-origin: 356px 60px; }
  @keyframes breathe { 0%, 100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.18); opacity: 1; } }
  .rays { transform-origin: 356px 60px; animation: spin 60s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .cloud { animation: float 6s ease-in-out infinite; }
  .rain path { stroke-dasharray: 18; stroke-dashoffset: 18; animation: drop 1.1s linear infinite; }
  @keyframes drop { 0% { stroke-dashoffset: 18; opacity: 0; } 20% { opacity: 1; } 100% { stroke-dashoffset: -18; opacity: 0; } }
  .mosquito { animation: buzz 1.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes buzz { 0%, 100% { transform: translate(60px, -20px) scale(1.3) rotate(0); } 50% { transform: translate(64px, -26px) scale(1.3) rotate(-6deg); } }
  .flow path { stroke-dasharray: 4 4; animation: dash 1.2s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -8; } }
  .dot-alert { transform-box: fill-box; transform-origin: center; animation: ping 1.6s ease-out infinite; }
  @keyframes ping { 0% { transform: scale(1); opacity: 1; } 70% { transform: scale(1.45); opacity: 0.55; } 100% { transform: scale(1); opacity: 1; } }
  .status { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px; }
  .status > div { display: flex; gap: 12px; align-items: flex-start; }
  .status > div > div { display: flex; flex-direction: column; gap: 2px; }
  .big { font-size: 1.6rem; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .nino27 { margin-top: 16px; display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px 28px; align-items: center; border-left: 5px solid var(--series-2); overflow: hidden; }
  .nino27 h2 { font-size: 1.35rem; line-height: 1.3; margin: 4px 0 8px; }
  .nino27 h2 em { font-style: normal; color: var(--series-2); }
  .nino27 .eyebrow { display: inline-flex; align-items: center; gap: 6px; }
  .mini-bars { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px; align-items: end; height: 150px; }
  .mini-bars li { display: flex; flex-direction: column; align-items: center; gap: 4px; height: 100%; justify-content: flex-end; }
  .mb-bar { width: 100%; max-width: 44px; flex: 1; display: flex; align-items: flex-end; background: var(--surface-2); border-radius: 6px; overflow: hidden; }
  .mb-bar i { display: block; width: 100%; background: var(--seq-4); border-radius: 6px 6px 0 0; transition: height 0.9s var(--ease); }
  .mb-bar i.peak { background: var(--series-2); }
  .mb-label { font-size: 0.72rem; font-weight: 700; color: var(--text-2); }
  .mb-val { font-size: 0.72rem; }
  .mb-note { grid-column: 1 / -1; margin: 0; }
  .impact { margin-top: 16px; display: grid; gap: 10px; border-left: 5px solid var(--series-1); }
  .impact h2 { margin: 0; font-size: 1.35rem; line-height: 1.3; max-width: 900px; }
