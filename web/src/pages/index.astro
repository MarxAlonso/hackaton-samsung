---
import Layout from "../layouts/Layout.astro";
import app from "../../public/data/app.json";
import { icon } from "../lib/icons";

const actual = app.escenarios.actual;
const altos = actual.distritos.filter((d) => d.riesgos.dengue.nivel === "alto").length;
const medios = actual.distritos.filter((d) => d.riesgos.dengue.nivel === "medio").length;
const semana = new Date(actual.semana + "T12:00:00").toLocaleDateString("es-PE", { day: "numeric", month: "long", year: "numeric" });
const nino = actual.nino12;
---

<Layout title="Inicio" active="inicio">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Tumbes · Piura · Lambayeque — {app.distritos.length} distritos</p>
      <h1>El Niño costero ya está aquí.<br />Anticipa el dengue antes de que llegue.</h1>
      <p class="lead muted">
        Combinamos lluvia, temperatura y el calentamiento del mar con un modelo de inteligencia artificial para avisar,
        con hasta 4 semanas de anticipación, en qué distritos puede haber brotes de dengue y otras enfermedades.
      </p>
      <div class="cta">
        <a class="btn primary" href="/autoridad"><Fragment set:html={icon("hospital", 18)} /> Abrir panel de autoridad</a>
        <a class="btn" href="/ciudadano"><Fragment set:html={icon("home", 18)} /> Ver mi distrito</a>
      </div>
    </div>

    <!-- Ilustración: del mar caliente a la alerta -->
    <svg class="hero-art" viewBox="0 0 420 300" role="img" aria-label="Diagrama: el mar se calienta, llueve más, se forman criaderos y suben los casos; el sistema alerta antes">
      <defs>
        <linearGradient id="sea" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--series-2)" stop-opacity=".9"/><stop offset="1" stop-color="var(--series-1)" stop-opacity=".9"/></linearGradient>
        <linearGradient id="sky" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--brand-soft)"/><stop offset="1" stop-color="var(--surface)"/></linearGradient>
      </defs>
      <rect x="0" y="0" width="420" height="300" rx="20" fill="url(#sky)" stroke="var(--border)"/>
      <!-- mar -->
      <path d="M0 230 Q 35 212 70 230 T 140 230 T 210 230 T 280 230 T 350 230 T 420 230 V 300 H 0 Z" fill="url(#sea)"/>
      <path d="M0 250 Q 35 236 70 250 T 140 250 T 210 250 T 280 250 T 350 250 T 420 250" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="2"/>
      <g transform="translate(26 246)" fill="#fff" font-size="11" font-weight="700" font-family="system-ui">
        <text y="20">Mar +{nino.toFixed(1)} °C</text>
        <text y="34" font-weight="400" opacity=".9">Niño 1+2 · NOAA</text>
      </g>
      <!-- sol -->
      <circle cx="356" cy="60" r="26" fill="var(--warning)" opacity=".9"/>
      <g stroke="var(--warning)" stroke-width="3" stroke-linecap="round" opacity=".8">
        <path d="M356 18v10M356 92v10M314 60h10M388 60h10M326 30l7 7M379 83l7 7M326 90l7-7M379 37l7-7"/>
      </g>
      <!-- nube con lluvia -->
      <g transform="translate(110 40)">
        <path d="M30 70a22 22 0 0 1 4-43 30 30 0 0 1 57 6 20 20 0 0 1 3 40z" fill="var(--surface)" stroke="var(--text-3)" stroke-width="2"/>
        <g stroke="var(--series-1)" stroke-width="3" stroke-linecap="round">
          <path d="M34 84l-6 16M56 84l-6 16M78 84l-6 16M45 100l-6 14M67 100l-6 14"/>
        </g>
      </g>
      <!-- balde con agua + zancudo -->
      <g transform="translate(220 150)">
        <path d="M8 10h52l-6 46H14z" fill="var(--surface-3)" stroke="var(--text-2)" stroke-width="2"/>
        <path d="M14 22h40" stroke="var(--series-1)" stroke-width="4" stroke-linecap="round"/>
        <g transform="translate(60 -20) scale(1.3)" fill="none" stroke="var(--text)" stroke-width="1.7" stroke-linecap="round">
          <ellipse cx="12" cy="13" rx="2.2" ry="5" fill="var(--text)"/><circle cx="12" cy="6.5" r="1.6" fill="var(--text)"/>
          <path d="M12 5l-2-3M12 5l2-3M10 11L4 8M14 11l6-3M10 14l-5 3M14 14l5 3M11 18l-2 4M13 18l2 4"/>
        </g>
      </g>
      <!-- flechas del proceso -->
      <g fill="none" stroke="var(--text-2)" stroke-width="2" stroke-dasharray="4 4">
        <path d="M175 160q25 20 45 20"/><path d="M80 230q30-50 60-70" />
      </g>
      <!-- tarjeta de alerta -->
      <g transform="translate(300 170)">
        <rect x="0" y="0" width="104" height="62" rx="10" fill="var(--surface)" stroke="var(--critical)" stroke-width="2"/>
        <circle cx="18" cy="18" r="7" fill="var(--critical)"/>
        <text x="32" y="22" font-size="11" font-weight="700" fill="var(--text)" font-family="system-ui">Riesgo alto</text>
        <text x="10" y="42" font-size="10" fill="var(--text-2)" font-family="system-ui">brote en 3 semanas</text>
        <text x="10" y="55" font-size="10" fill="var(--text-2)" font-family="system-ui">confianza alta</text>
      </g>
    </svg>
  </section>

  <section class="status card" role="status">
    <div>
      <span class="ico-box brand"><Fragment set:html={icon("wave", 22)} /></span>
      <div><span class="eyebrow">Mar frente a Piura y Tumbes</span><strong class="big">{nino > 0 ? "+" : ""}{nino.toFixed(1)} °C</strong><span class="muted small">sobre lo normal · NOAA, semana del {semana}</span></div>
    </div>
    <div>
      <span class="ico-box brand"><Fragment set:html={icon("mosquito", 22)} /></span>
      <div><span class="eyebrow">Distritos en riesgo de dengue</span><strong class="big">{altos} alto · {medios} medio</strong><span class="muted small">próximas 4 semanas</span></div>
    </div>
    <div>
      <span class="ico-box brand"><Fragment set:html={icon("calendar", 22)} /></span>
      <div><span class="eyebrow">Época de mayor riesgo</span><strong class="big">Enero – mayo</strong><span class="muted small">el ENFEN prevé que El Niño costero dure hasta el verano 2027</span></div>
    </div>
  </section>

  <section class="choices" aria-label="Elige tu perfil">
    <a class="choice card" href="/ciudadano">
      <span class="ico-box brand"><Fragment set:html={icon("home", 24)} /></span>
      <h2>Soy ciudadano</h2>
      <p class="muted">Elige tu distrito y mira, como un semáforo, los 3 riesgos principales y qué hacer en casa.</p>
      <span class="btn primary">Ver mi distrito <Fragment set:html={icon("arrowRight", 16)} /></span>
    </a>
    <a class="choice card" href="/autoridad">
      <span class="ico-box brand"><Fragment set:html={icon("hospital", 24)} /></span>
      <h2>Soy autoridad de salud</h2>
      <p class="muted">Distritos priorizados, probabilidad de brote, casos esperados, mapa de calor, comparaciones y simulador de lluvias.</p>
      <span class="btn primary">Abrir panel <Fragment set:html={icon("arrowRight", 16)} /></span>
    </a>
  </section>

  <section class="steps">
    <h2>Cómo funciona</h2>
    <ol>
      <li class="card"><span class="ico-box brand"><Fragment set:html={icon("database", 22)} /></span><div><strong>1. Datos reales</strong><p class="muted small">Lluvia, temperatura y humedad de cada distrito (Open-Meteo) y el índice de El Niño (NOAA), actualizados por API.</p></div></li>
      <li class="card"><span class="ico-box brand"><Fragment set:html={icon("cpu", 22)} /></span><div><strong>2. El modelo predice</strong><p class="muted small">Un modelo entrenado en Python calcula la probabilidad de brote y un rango de casos, con su nivel de confianza.</p></div></li>
      <li class="card"><span class="ico-box brand"><Fragment set:html={icon("user", 22)} /></span><div><strong>3. Tú decides</strong><p class="muted small">La IA lo traduce en acciones concretas: fumigar, abastecer pruebas o, en casa, eliminar criaderos.</p></div></li>
    </ol>
    <p><a href="/autoridad?escenario=2023" class="inline-ico">¿Qué habría anticipado el sistema en la epidemia de 2023? <Fragment set:html={icon("arrowRight", 16)} /></a></p>
  </section>
</Layout>

<style>
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 28px; align-items: center; padding: 12px 0 24px; }
  .lead { font-size: 1.1rem; max-width: 640px; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .hero-art { width: 100%; height: auto; }
  .status { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .status > div { display: flex; gap: 12px; align-items: flex-start; }
  .status > div > div { display: flex; flex-direction: column; gap: 2px; }
  .big { font-size: 1.6rem; letter-spacing: -0.01em; }
  .choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 28px 0; }
  .choice { text-decoration: none; color: var(--text); display: flex; flex-direction: column; gap: 8px; transition: transform 0.15s; }
  .choice:hover { transform: translateY(-2px); border-color: var(--brand); }
  .choice .btn { align-self: flex-start; margin-top: auto; }
  .steps ol { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .steps li { display: flex; gap: 12px; align-items: flex-start; }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; } }
</style>
