  :global(table.mini) { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin-top: 12px; }
  :global(table.mini th), :global(table.mini td) { text-align: left; padding: 8px 6px; border-top: 1px solid var(--border); }
