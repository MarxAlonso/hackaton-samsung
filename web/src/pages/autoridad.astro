  :global(.detail h2) { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 1.7rem; }
  :global(.detail h3) { margin-top: 18px; font-size: 1rem; }
  :global(.headline-prob) { font-size: 1.1rem; }
  :global(.headline-prob strong) { font-size: 1.7rem; }
  :global(.climate-chips) { display: flex; gap: 8px; flex-wrap: wrap; }
  :global(.chip-c) { display: inline-flex; align-items: center; gap: 6px; background: var(--surface-2); border-radius: 10px; padding: 8px 12px; font-weight: 700; }
  :global(.chip-c svg) { color: var(--brand); }
  :global(.chip-c small) { font-weight: 400; color: var(--text-2); }
  :global(.detail-grid) { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
