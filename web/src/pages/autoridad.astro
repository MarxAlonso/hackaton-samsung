  @media (max-width: 900px) {
    .row2, :global(.detail-grid), :global(.flood-grid) { grid-template-columns: 1fr; }
    #map { height: 320px; }
  }
  @media (max-width: 480px) {
    :global(.ranking button) { grid-template-columns: minmax(0, 1fr) 48px 70px; }
    :global(.ranking .bar) { display: none; }
