  :global(.riskrow) { display: grid; grid-template-columns: minmax(0, 1.3fr) 1fr 48px; gap: 10px; align-items: center; padding: 7px 0; font-size: 0.9rem; border-top: 1px solid var(--border); }
  :global(.riskrow svg) { color: var(--text-2); }
  :global(.ai-actions) { margin-top: 18px; }
