    width: 100%; display: grid; grid-template-columns: minmax(0, 1.4fr) 1fr 48px 78px; align-items: center; gap: 10px;
    background: none; border: 0; border-top: 1px solid var(--border); padding: 10px 6px; cursor: pointer; text-align: left; color: var(--text);
  }
