---
import Layout from "../layouts/Layout.astro";
import { icon } from "../lib/icons";
import app from "../../public/data/app.json";

const m = app.metricas;
const dm = m.dengue.modelo;
const base = m.dengue.linea_base_canal_endemico;
const casos = m.dengue.casos;
const NAMES: Record<string, string> = {
  rain_0_1: "Lluvia de las últimas 2 semanas",
  rain_2_6: "Lluvia de hace 2 a 6 semanas",
  rain_7_12: "Lluvia de hace 7 a 12 semanas",
  tmean_0_3: "Temperatura media (4 semanas)",
  tmax_0: "Temperatura máxima",
  humidity_0_3: "Humedad (4 semanas)",
  nino12: "Calentamiento del mar (Niño 1+2)",
  oni: "Índice ONI (El Niño global)",
  inc_0: "Casos de esta semana",
  inc_0_3: "Casos de las últimas 4 semanas",
  inc_52: "Casos del último año (inmunidad)",
  canal_next: "Umbral del canal endémico",
  altitude: "Altitud",
  water_access: "Acceso a agua por red",
  log_pop: "Población",
  week_sin: "Época del año (ciclo)",
  week_cos: "Época del año (fase)",
};
const importance = Object.entries(m.dengue.importancia_variables as Record<string, number>).slice(0, 8);
const maxImp = importance[0][1];
const DISEASE = app.contenido.enfermedades as Record<string, { nombre: string }>;

// Diagrama de confiabilidad (predicho vs observado)
const rel = m.dengue.confiabilidad as { predicho: number; observado: number; n: number }[];
const S = 260, P = 34;
const sx = (v: number) => P + v * (S - P - 10);
const sy = (v: number) => S - P - v * (S - P - 10);

// Monitoreo y reentrenamiento
const mon: any = (app as any).monitoreo;
const rt: any = (app as any).reentrenamiento;
const ext: any = (app as any).lluvias_extremas;
const driftTop = mon.deriva_variables.slice(0, 6);
const qs = mon.desempeno_por_trimestre.filter((q: any) => q.n >= 100);
const qRef = mon.brier_validacion;
const qMax = Math.max(...qs.map((q: any) => q.brier), qRef * 2) * 1.12;
const QW = 460, QH = 230, QL = 44, QB = 40;
const qSlot = (QW - QL - 10) / Math.max(qs.length, 1);
const qx = (i: number) => QL + (i + 0.5) * qSlot;
const qbw = Math.min(28, qSlot * 0.66);
const qy = (v: number) => QH - QB - (v / qMax) * (QH - QB - 16);
const corrected = mon.estado === "reentrenar" && rt.decision === "promovido";
const stateLabel = corrected ? "Deriva detectada y corregida" : mon.estado === "reentrenar" ? "Deriva detectada: se mantiene el campeón" : mon.estado === "vigilar" ? "Vigilar" : "Estable";
const stateLevel = corrected ? "medio" : mon.estado === "reentrenar" ? "alto" : mon.estado === "vigilar" ? "medio" : "bajo";
const driftLevel: Record<string, string> = { alerta: "alto", vigilar: "medio", estable: "bajo" };
const driftLabel: Record<string, string> = { alerta: "Deriva fuerte", vigilar: "Vigilar", estable: "Estable" };
const yearsData = Object.entries(ext.dias_distrito_sobre_umbral_alto_por_anio as Record<string, number>);
const FW = 460, FH = 200, FL = 40, FB = 30;
const fMax = Math.max(...yearsData.map(([, v]) => v), 1) * 1.1;
const fSlot = (FW - FL - 10) / yearsData.length;
const fy = (v: number) => FH - FB - (v / fMax) * (FH - FB - 16);
const fmt1 = (v: number | null | undefined) => (v == null ? "—" : String(v));
---

<Layout title="Cómo funciona" active="modelo" description="Datos, modelo, métricas y límites de Alerta Salud Niño.">
  <h1>Cómo funciona el modelo</h1>
  <p class="muted lead">Ficha técnica (model card) resumida. Entrenado con {m.periodo_entrenamiento}; evaluado con {m.periodo_prueba}, un periodo que el modelo nunca vio e incluye la epidemia de 2023.</p>

  <section class="tiles">
    <div class="card tile"><span class="eyebrow">Detecta brotes (AUC)</span><strong>{dm.auc}</strong><span class="small muted">canal endémico: {base.auc} · 1 = perfecto, 0,5 = azar</span></div>
    <div class="card tile"><span class="eyebrow">Anticipa brotes nuevos</span><strong>{m.dengue.subconjuntos.anticipacion_brote_nuevo.pr_auc}</strong><span class="small muted">PR-AUC cuando el distrito aún está bajo el umbral; al azar sería {m.dengue.subconjuntos.anticipacion_brote_nuevo.tasa_brote}</span></div>
    <div class="card tile"><span class="eyebrow">Brotes anticipados (recall)</span><strong>{Math.round(dm.recall * 100)}%</strong><span class="small muted">canal endémico: {Math.round(base.recall * 100)}%</span></div>
    <div class="card tile"><span class="eyebrow">Precisión de alertas</span><strong>{Math.round(dm.precision * 100)}%</strong><span class="small muted">canal endémico: {Math.round(base.precision * 100)}%</span></div>
    <div class="card tile"><span class="eyebrow">Error en casos (MAE, 4 semanas)</span><strong>{casos.mae_modelo_p50}</strong><span class="small muted">repetir últimas 4 semanas: {casos.mae_linea_base_ultimas_4_semanas}</span></div>
    <div class="card tile"><span class="eyebrow">Rango que acierta</span><strong>{Math.round(casos.cobertura_p10_p90 * 100)}%</strong><span class="small muted">casos reales dentro del rango P10–P90 (ideal ≈ 80%)</span></div>
  </section>

  <p class="notice small">El AUC global se ve muy alto porque muchas semanas son fáciles (temporada seca, distritos de altura).
    En temporada de lluvias con casos activos el AUC es {m.dengue.subconjuntos.temporada_con_casos.auc}, y la métrica más exigente
    —anticipar un brote nuevo— se muestra arriba. Así lo presentamos, sin inflar resultados.</p>

  <section class="two">
    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("shield", 20)} /> ¿Podemos confiar en el porcentaje?</h2>
      <p class="small muted">Si el modelo dice 70%, el brote debería ocurrir ~7 de cada 10 veces. Los puntos cerca de la diagonal indican probabilidades confiables.</p>
      <svg viewBox={`0 0 ${S} ${S}`} width="100%" style="max-width:420px" role="img" aria-label="Diagrama de confiabilidad">
        {[0, 0.5, 1].map((t) => (
          <>
            <line x1={sx(0)} x2={sx(1)} y1={sy(t)} y2={sy(t)} stroke="var(--border)" />
            <text x={P - 6} y={sy(t) + 4} font-size="10" text-anchor="end" fill="var(--text-3)">{Math.round(t * 100)}%</text>
            <text x={sx(t)} y={S - P + 14} font-size="10" text-anchor="middle" fill="var(--text-3)">{Math.round(t * 100)}%</text>
          </>
        ))}
        <line x1={sx(0)} y1={sy(0)} x2={sx(1)} y2={sy(1)} stroke="var(--threshold)" stroke-dasharray="3 3" />
        <polyline points={rel.map((r) => `${sx(r.predicho)},${sy(r.observado)}`).join(" ")} fill="none" stroke="var(--series-1)" stroke-width="2" />
        {rel.map((r) => (
          <circle cx={sx(r.predicho)} cy={sy(r.observado)} r="5" fill="var(--series-1)" stroke="var(--surface)" stroke-width="2">
            <title>Predicho {Math.round(r.predicho * 100)}% → ocurrió {Math.round(r.observado * 100)}% ({r.n} casos)</title>
          </circle>
        ))}
        <text x={sx(0.5)} y={S - 4} font-size="10" text-anchor="middle" fill="var(--text-2)">Probabilidad predicha</text>
      </svg>
      <div class="legend"><span><i style="background:var(--series-1)"></i>Modelo</span><span><i style="background:repeating-linear-gradient(90deg,var(--threshold) 0 3px,transparent 3px 6px)"></i>Calibración perfecta</span></div>
    </div>

    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("cpu", 20)} /> ¿En qué se fija el modelo?</h2>
      <p class="small muted">Las 8 variables que más pesan. Los casos recientes dominan (un brote en curso tiende a seguir); el clima es lo que permite anticipar los brotes nuevos.</p>
      <ul class="imp">
        {importance.map(([k, v]) => (
          <li>
            <span>{NAMES[k] ?? k}</span>
            <span class="bar"><i style={`width:${(v / maxImp) * 100}%;background:var(--series-1)`}></i></span>
            <span class="num">{Math.round(v * 100)}%</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="card">
    <h2 class="chart-title"><Fragment set:html={icon("activity", 20)} /> Otras enfermedades</h2>
    <p class="small muted">Modelos más simples (regresión logística) que estiman la probabilidad de semanas de riesgo alto (casos sobre el percentil 80 del distrito).</p>
    <table>
      <thead><tr><th>Enfermedad</th><th>AUC</th><th>Recall</th><th>Precisión</th><th>Detonante climático</th></tr></thead>
      <tbody>
        {Object.entries(m.otras_enfermedades as Record<string, { auc: number; recall: number; precision: number }>).map(([k, v]) => (
          <tr>
            <td>{DISEASE[k]?.nombre ?? k}</td><td>{v.auc}</td><td>{Math.round(v.recall * 100)}%</td><td>{Math.round(v.precision * 100)}%</td>
            <td class="muted small">{{ leptospirosis: "Lluvias intensas e inundaciones", eda: "Calor y falta de agua segura", golpe_calor: "Temperatura máxima extrema", ira: "Cambios bruscos de temperatura" }[k]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="card mon-head">
    <div>
      <h2 class="chart-title"><Fragment set:html={icon("refresh", 20)} /> Monitoreo y reentrenamiento automático</h2>
      <p class="small muted">Cada semana el sistema revisa si los datos cambiaron, si el modelo sigue acertando y, si hace falta, prueba un modelo nuevo contra el actual.</p>
    </div>
    <span class={`badge lvl-${stateLevel}`}>{stateLabel}</span>
  </section>
  {mon.motivos.length > 0 && (
    <p class="notice small"><strong>Qué detectó el monitoreo:</strong> {mon.motivos.join("; ")}.</p>
  )}

  <section class="two">
    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("database", 20)} /> ¿Cambiaron los datos?</h2>
      <p class="small muted">Índice de estabilidad (PSI) de la ventana {mon.ventana_reciente.desde} → {mon.ventana_reciente.hasta} frente a la misma época de 2015–2021. Menos de 0,10 = estable; más de 0,25 = deriva fuerte.</p>
      <ul class="drift">
        {driftTop.map((d: any) => (
          <li>
            <span>{d.nombre}</span>
            <span class="bar" title={`PSI ${d.psi}`}><i style={`width:${Math.min(d.psi, 1) * 100}%;background:${d.estado === "alerta" ? "var(--critical)" : d.estado === "vigilar" ? "var(--warning)" : "var(--good)"}`}></i></span>
            <span class="num">{d.psi}</span>
            <span class={`badge lvl-${driftLevel[d.estado]}`}>{driftLabel[d.estado]}</span>
            <span class="small muted">{d.fuera_de_rango_pct > 0 ? `${d.fuera_de_rango_pct}% fuera del rango visto` : ""}</span>
          </li>
        ))}
      </ul>
      <p class="small muted">El mar Niño 1+2 hoy está en {mon.deriva_variables.find((d: any) => d.variable === "nino12")?.reciente_max} °C; en el entrenamiento original el máximo fue {mon.deriva_variables.find((d: any) => d.variable === "nino12")?.entrenamiento_max} °C: el modelo estaba extrapolando.</p>
    </div>

    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("chart", 20)} /> ¿Sigue acertando?</h2>
      <p class="small muted">Error de las probabilidades (Brier, menos es mejor) del modelo de evaluación por trimestre. La línea es el error de validación; en rojo, más de 1,5× esa línea.</p>
      <svg viewBox={`0 0 ${QW} ${QH}`} width="100%" style="max-width:520px" role="img" aria-label="Error del modelo por trimestre">
        {[0, 0.5, 1].map((t) => (
          <>
            <line x1={QL} x2={QW - 10} y1={qy(t * qMax)} y2={qy(t * qMax)} stroke="var(--border)" />
            <text x={QL - 6} y={qy(t * qMax) + 4} font-size="10" text-anchor="end" fill="var(--text-3)">{(t * qMax).toFixed(3)}</text>
          </>
        ))}
        <line x1={QL} x2={QW - 10} y1={qy(qRef)} y2={qy(qRef)} stroke="var(--threshold)" stroke-width="1.5" stroke-dasharray="5 4" />
        <text x={QW - 12} y={qy(qRef) - 5} font-size="10" text-anchor="end" fill="var(--text-2)">validación {qRef}</text>
        {qs.map((q: any, i: number) => (
          <>
            <rect x={qx(i) - qbw / 2} y={qy(q.brier)} width={qbw} height={Math.max(1, QH - QB - qy(q.brier))} rx="3" fill={q.brier > 1.5 * qRef ? "var(--critical)" : "var(--series-1)"}>
              <title>{q.periodo}: Brier {q.brier} · {q.n} semanas-distrito · tasa de brote {q.tasa_brote}</title>
            </rect>
            <text x={qx(i)} y={QH - QB + 14} font-size="9.5" text-anchor="middle" fill="var(--text-3)" transform={`rotate(-35 ${qx(i)} ${QH - QB + 14})`}>{q.periodo}</text>
          </>
        ))}
      </svg>
      <p class="small muted">Brier reciente (últimos 2 trimestres): <strong>{mon.brier_reciente}</strong> frente a <strong>{mon.brier_validacion}</strong> en validación.</p>
    </div>
  </section>

  <section class="card">
    <h2 class="chart-title"><Fragment set:html={icon("award", 20)} /> Campeón contra retador</h2>
    <p class="small muted">Se entrena un modelo nuevo con todo lo etiquetado hasta {rt.ventana_comparacion.desde} y ambos se comparan en las {rt.ventana_comparacion.semanas} semanas siguientes ({rt.ventana_comparacion.desde} → {rt.ventana_comparacion.hasta}), que ninguno vio al entrenar.</p>
    <table>
      <thead><tr><th>Modelo</th><th>Brier</th><th>AUC</th><th>Error en casos (MAE)</th><th>Rango que acierta</th></tr></thead>
      <tbody>
        <tr><td><strong>Campeón</strong> <span class="small muted">{rt.campeon.nombre}</span></td><td>{rt.campeon.brier}</td><td>{fmt1(rt.campeon.auc)}</td><td>{rt.campeon.mae_casos_p50}</td><td>{Math.round(rt.campeon.cobertura_p10_p90 * 100)}%</td></tr>
        <tr><td><strong>Retador</strong> <span class="small muted">{rt.retador.nombre}</span></td><td>{rt.retador.brier}</td><td>{fmt1(rt.retador.auc)}</td><td>{rt.retador.mae_casos_p50}</td><td>{Math.round(rt.retador.cobertura_p10_p90 * 100)}%</td></tr>
      </tbody>
    </table>
    <p class={`verdict ${rt.decision === "promovido" ? "ok" : ""}`}>
      <Fragment set:html={icon(rt.decision === "promovido" ? "checkCircle" : "info", 18)} />
      <span><strong>{rt.decision === "promovido" ? "El retador fue promovido a producción." : "Se mantiene el campeón."}</strong> {rt.motivo} <span class="muted">{rt.regla}</span></span>
    </p>
    <p class="small muted">Las predicciones de <strong>hoy</strong> usan el modelo en producción ({rt.modelo_en_produccion.origen}, datos hasta {rt.modelo_en_produccion.entrenado_hasta}). Los replays de 2017 y 2023 usan el campeón de evaluación, que nunca vio esas epidemias. Cada entrenamiento queda registrado (MLflow y <code>experiments.jsonl</code>).</p>
  </section>

  <section class="card">
    <h2 class="chart-title"><Fragment set:html={icon("flood", 20)} /> Lluvias extremas: ¿el índice funciona?</h2>
    <p class="small muted">{ext.metodo} Días-distrito sobre el umbral extremo por año: debe destacar los años de Niño costero. Los umbrales se fijaron con 2015–2021, así que 2023 no se usó para calibrarlos.</p>
    <svg viewBox={`0 0 ${FW} ${FH}`} width="100%" style="max-width:560px" role="img" aria-label="Días-distrito sobre el umbral extremo por año">
      {[0, 0.5, 1].map((t) => (
        <>
          <line x1={FL} x2={FW - 10} y1={fy(t * fMax)} y2={fy(t * fMax)} stroke="var(--border)" />
          <text x={FL - 6} y={fy(t * fMax) + 4} font-size="10" text-anchor="end" fill="var(--text-3)">{Math.round(t * fMax)}</text>
        </>
      ))}
      {yearsData.map(([y, v], i) => (
        <>
          <rect x={FL + i * fSlot + fSlot * 0.17} y={fy(v)} width={fSlot * 0.66} height={Math.max(1, FH - FB - fy(v))} rx="3" fill={y === "2017" || y === "2023" ? "var(--critical)" : "var(--series-1)"}>
            <title>{y}: {v} días-distrito</title>
          </rect>
          {v > 0 && <text x={FL + i * fSlot + fSlot / 2} y={fy(v) - 4} font-size="10" text-anchor="middle" fill="var(--text-2)">{v}</text>}
          <text x={FL + i * fSlot + fSlot / 2} y={FH - FB + 14} font-size="10" text-anchor="middle" fill="var(--text-3)">{y}</text>
        </>
      ))}
    </svg>
    <p class="small muted">Rojo: 2017 (Niño costero) y 2023 (ciclón Yaku). No es un modelo entrenado con inundaciones reales (no hay inventario público por distrito): es un índice de umbrales, el enfoque habitual de las alertas por lluvia.</p>
  </section>

  <section class="two">
    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("database", 20)} /> Datos</h2>
      <ul class="small">
        <li><strong>Clima (real):</strong> lluvia, temperatura y humedad diarias 2015–2026 por distrito. Open-Meteo Archive API (reanálisis ERA5).</li>
        <li><strong>El Niño (real):</strong> anomalía semanal del mar Niño 1+2 y el índice ONI. NOAA Climate Prediction Center.</li>
        <li><strong>Pronóstico (real):</strong> lluvia y temperatura de los próximos 16 días. Open-Meteo.</li>
        <li><strong>Casos (simulados):</strong> generados a partir del clima real con mecanismos epidemiológicos (criaderos por lluvia, temperatura, altitud, agua almacenada, inmunidad tras brotes). Los datos por distrito del CDC-MINSA se publican en PDF; el siguiente paso es conectarlos.</li>
        <li><strong>Distritos:</strong> {app.distritos.length} de Tumbes, Piura y Lambayeque. Población y acceso a agua aproximados (INEI).</li>
      </ul>
    </div>
    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("info", 20)} /> Límites y uso responsable</h2>
      <ul class="small">
        <li>Es un sistema de <strong>apoyo a la decisión</strong>: no reemplaza la vigilancia epidemiológica ni los comunicados del MINSA/ENFEN.</li>
        <li>Los casos son simulados: las métricas muestran que el método funciona, no la precisión con datos reales.</li>
        <li>La IA solo redacta explicaciones con los números del modelo; no diagnostica ni receta.</li>
        <li>No usa datos personales: todo se trabaja agregado por distrito y semana.</li>
        <li>El monitoreo semanal mide la deriva de los datos y el error reciente; si hace falta, un retador compite contra el modelo actual y solo se promueve si mejora de forma clara.</li>
        <li>El plan de brigadas usa supuestos editables (efectividad, capacidad y costos de ejemplo): es una guía de priorización, no una orden de operaciones.</li>
      </ul>
    </div>
  </section>

  <section class="card">
    <h2 class="chart-title"><Fragment set:html={icon("layers", 20)} /> Arquitectura</h2>
    <pre class="arch">Python (ml/) ─ ingest (incremental) → simulate → train → monitor → retrain → export
   │  APIs: Open-Meteo + NOAA     GradientBoosting + cuantiles + logística
   │  campeón vs retador · índice de lluvias extremas · registro MLflow
   ▼
app.json + modelos .onnx ──▶ Astro en Cloudflare (este sitio)
                               ├─ simulador en el navegador (onnxruntime-web)
                               ├─ plan de brigadas (optimizador en el navegador)
                               └─ /api/explicar → Workers AI (Llama 3.3)
FastAPI (api/) + Docker ──▶ /predict · /predict/batch · /optimize · /monitoreo · /health</pre>
    <p class="small muted">Datos generados el {app.generado}.</p>
  </section>
</Layout>

<style>
  .lead { max-width: 820px; }
  .notice { margin-bottom: 16px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin: 20px 0; }
  .tile { display: flex; flex-direction: column; gap: 2px; }
  .tile strong { font-size: 1.8rem; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 16px; }
  section.card { margin-bottom: 16px; }
  .imp { list-style: none; padding: 0; margin: 0; }
  .imp li { display: grid; grid-template-columns: minmax(0, 1.6fr) 1fr 40px; gap: 10px; align-items: center; padding: 7px 0; font-size: 0.9rem; border-top: 1px solid var(--border); }
  .bar { height: 8px; background: var(--surface-2); border-radius: 4px; overflow: hidden; }
  .bar i { display: block; height: 100%; border-radius: 4px; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 8px 6px; border-top: 1px solid var(--border); }
  th { color: var(--text-2); font-weight: 600; }
  .mon-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; flex-wrap: wrap; }
  .mon-head .chart-title { margin-bottom: 4px; }
  .drift { list-style: none; padding: 0; margin: 8px 0; }
  .drift li { display: grid; grid-template-columns: minmax(0, 1.5fr) 0.9fr 44px auto; gap: 8px 10px; align-items: center; padding: 8px 0; border-top: 1px solid var(--border); font-size: 0.88rem; }
  .drift li > span:last-child { grid-column: 1 / -1; margin-top: -4px; }
  .verdict { display: flex; gap: 8px; align-items: flex-start; background: var(--surface-2); border-radius: 10px; padding: 10px 12px; margin: 12px 0; font-size: 0.92rem; }
  .verdict.ok { background: var(--good-soft); }
  .arch { background: var(--surface-2); padding: 14px; border-radius: 10px; overflow-x: auto; font-size: 0.8rem; }
  @media (max-width: 600px) { table { display: block; overflow-x: auto; } }
</style>
