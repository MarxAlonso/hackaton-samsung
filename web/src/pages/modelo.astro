---
import Layout from "../layouts/Layout.astro";
import { icon } from "../lib/icons";
import Acc from "../components/Acc.astro";
import Help from "../components/Help.astro";
import app from "../../public/data/app.json";

const m: any = app.metricas;
const A: any = m.dengue;          // modelo con casos recientes
const C: any = m.dengue_clima;    // modelo solo clima (el de hoy)
const datos: any = (app as any).datos;
const pc = (v: number) => `${Math.round(v * 100)}%`;
const ic = (m: any, key: string, percent = false) => {
  const r = m.intervalos_95?.[key];
  return r ? `IC 95%: ${r.map((v: number) => (percent ? pc(v) : v)).join(" a ")}` : "";
};
const NAMES: Record<string, string> = {
  rain_0_1: "Lluvia de las últimas 2 semanas",
  rain_2_6: "Lluvia de hace 2 a 6 semanas",
  rain_7_12: "Lluvia de hace 7 a 12 semanas",
  tmean_0_3: "Temperatura media (4 semanas)",
  tmax_0: "Temperatura máxima",
  humidity_0_3: "Humedad (4 semanas)",
  nino12: "Calentamiento del mar (Niño 1+2)",
  oni: "Índice ONI (El Niño global)",
  inc_0: "Casos de esta semana",
  inc_0_3: "Casos de las últimas 4 semanas",
  inc_52: "Casos del último año (inmunidad)",
  canal_next: "Umbral del canal endémico",
  altitude: "Altitud",
  water_access: "Acceso a agua por red",
  log_pop: "Población",
  week_sin: "Época del año (ciclo)",
  week_cos: "Época del año (fase)",
};
const top = (o: Record<string, number>, n = 7) => Object.entries(o).slice(0, n);
const impA = top(A.importancia_variables), impC = top(C.importancia_variables);
const DISEASE = app.contenido.enfermedades as Record<string, { nombre: string }>;

// Diagrama de confiabilidad (predicho vs observado) del modelo con casos
const rel = A.confiabilidad as { predicho: number; observado: number; n: number }[];
const S = 260, P = 34;
const sx = (v: number) => P + v * (S - P - 10);
const sy = (v: number) => S - P - v * (S - P - 10);

// Monitoreo y reentrenamiento
const mon: any = (app as any).monitoreo;
const rt: any = (app as any).reentrenamiento;
const ext: any = (app as any).lluvias_extremas;
const driftTop = mon.deriva_variables.slice(0, 6);
const qs = mon.desempeno_por_trimestre.filter((q: any) => q.n >= 100);
const qRef = mon.brier_validacion;
const qMax = Math.max(...qs.map((q: any) => q.brier), qRef * 2) * 1.12;
const QW = 460, QH = 230, QL = 44, QB = 40;
const qSlot = (QW - QL - 10) / Math.max(qs.length, 1);
const qx = (i: number) => QL + (i + 0.5) * qSlot;
const qbw = Math.min(28, qSlot * 0.66);
const qy = (v: number) => QH - QB - (v / qMax) * (QH - QB - 16);
const corrected = mon.estado === "reentrenar" && rt.decision === "promovido";
const stateLabel = corrected ? "Deriva detectada y corregida" : mon.estado === "reentrenar" ? "Deriva detectada: el reentrenamiento no mejoró el modelo" : mon.estado === "vigilar" ? "Vigilar" : "Estable";
const stateLevel = corrected ? "medio" : mon.estado === "reentrenar" ? "alto" : mon.estado === "vigilar" ? "medio" : "bajo";
const driftLevel: Record<string, string> = { alerta: "alto", vigilar: "medio", estable: "bajo" };
const driftLabel: Record<string, string> = { alerta: "Deriva fuerte", vigilar: "Vigilar", estable: "Estable" };
const yearsData = Object.entries(ext.dias_distrito_sobre_umbral_alto_por_anio as Record<string, number>);
const FW = 460, FH = 200, FL = 40, FB = 30;
const fMax = Math.max(...yearsData.map(([, v]) => v), 1) * 1.1;
const fSlot = (FW - FL - 10) / yearsData.length;
const fy = (v: number) => FH - FB - (v / fMax) * (FH - FB - 16);
const fmt1 = (v: number | null | undefined) => (v == null ? "—" : String(v));
const cov = datos.cobertura;
const FUENTES = [
  { k: "dengue", n: "Dengue", real: true, url: "https://www.datosabiertos.gob.pe/dataset/vigilancia-epidemiol%C3%B3gica-de-dengue" },
  { k: "eda", n: "Diarreas (EDA)", real: true, url: "https://www.datosabiertos.gob.pe/dataset/vigilancia-epidemiol%C3%B3gica-de-enfermedad-diarreica-aguda-eda" },
  { k: "ira", n: "Infecciones respiratorias (IRA)", real: true, url: "https://www.datosabiertos.gob.pe/dataset/vigilancia-epidemiologica-de-infecciones-respiratorias-agudas-ira" },
  { k: "leptospirosis", n: "Leptospirosis", real: true, url: "https://www.datosabiertos.gob.pe/dataset/vigilancia-epidemiol%C3%B3gica-de-las-zoonosis" },
  { k: "dengue_gore_piura", n: "Dengue 2025–2026 de Piura (contexto)", real: true, url: "https://www.datosabiertos.gob.pe/dataset/casos-de-dengue-en-la-regi%C3%B3n-piura-gobierno-regional-piura" },
  { k: "golpe_calor", n: "Golpe de calor", real: false, url: "" },
];
const otras: Record<string, any> = m.otras_enfermedades, otrasClima: Record<string, any> = m.otras_enfermedades_clima;
const lastQ = mon.ultimo_trimestre_con_casos;
const nuevo = A.subconjuntos.anticipacion_brote_nuevo;
const cal = A.calibracion_intensidad;
const sesgoC = C.razon_observado_previsto_por_anio;
const val: any = (app as any).validacion_externa_2026;
const ytd: any = (app as any).calibracion_acumulado_oficial;
const ytdT = ytd?.prueba_2022_2025?.total;
const yr = (y: number) => A.evaluacion_progresiva.find((r: any) => r.anio === y);
const yearsExt = ext.dias_distrito_sobre_umbral_alto_por_anio as Record<string, number>;
const SUM = {
  progresiva: `AUC con casos ${A.evaluacion_progresiva.map((r: any) => r.auc).join(" · ")} (2022 a 2025) · solo clima ${C.evaluacion_progresiva.map((r: any) => r.auc).join(" · ")}`,
  ic: `AUC con casos ${A.modelo.auc} (${ic(A, "auc")}) · solo clima ${C.modelo.auc} (${ic(C, "auc")})`,
  calib: `El sesgo de 2023 baja de ${cal.por_anio.find((r: any) => r.anio === 2023).razon_observado_previsto_antes}× a ${cal.por_anio.find((r: any) => r.anio === 2023).razon_observado_previsto_despues}× · solo con clima no se puede calibrar`,
  val: `AUC ${val.ordenamiento.auc_modelo_clima} contra ${val.ordenamiento.auc_linea_base_calendario} del calendario · la señal de arrastre no se integra`,
  ytd: ytdT ? `Sesgo ${ytdT.antes.razon_observado_previsto}× → ${ytdT.despues.razon_observado_previsto}× · rango ${pc(ytdT.antes.cobertura_p10_p90)} → ${pc(ytdT.despues.cobertura_p10_p90)} · es el ajuste que se aplica hoy` : "",
  conf: "Si dice 70%, ¿ocurre 7 de cada 10 veces? y en qué variables se fija el modelo",
  otras: "Leptospirosis, diarreas, infecciones respiratorias y golpe de calor (simulado)",
  mon: `${stateLabel} · ${rt.decision === "promovido" ? "retador promovido" : "se mantiene el campeón"}`,
  champ: rt.decision === "promovido" ? "El retador mejoró al campeón y pasó a producción" : "El retador no mejora lo suficiente: se mantiene el campeón",
  lluvia: `Días-distrito sobre el umbral extremo: ${yearsExt["2017"] ?? 0} en 2017 y ${yearsExt["2023"] ?? 0} en 2023, casi ninguno en años normales`,
  datos: "De dónde sale cada dato, hasta cuándo llega y qué se descartó",
  limites: "Qué no hace este sitio y cómo usarlo con responsabilidad",
  arq: "Del dato a esta página, paso a paso",
};
const texto2023 = `2023 fue una epidemia enorme: el ${pc(yr(2023).tasa_brote)} de las semanas-distrito estuvo en brote, contra ~15% en los años de entrenamiento. Con casos recientes el modelo la sigue bien (su error de probabilidades es ${(yr(2023).brier_sin_informacion / yr(2023).brier).toFixed(1)} veces menor que "sin información"). 2025 fue lo contrario, un año bajo (${pc(yr(2025).tasa_brote)} en brote): el modelo ordena igual de bien, pero casi no había brotes que anticipar y su ventaja es menor. Solo con clima casi no mejora el error, pero sí ordena los distritos por riesgo.`;
const fecha = (iso: string) => new Date(iso + "T12:00:00").toLocaleDateString("es-PE", { day: "numeric", month: "short", year: "numeric" });
---

<Layout title="Cómo funciona" active="modelo" description="Datos reales, modelo, métricas honestas y límites de Alerta Salud Niño.">
  <h1>Cómo funciona el modelo <Help k="panel_modelo" /></h1>
  <p class="muted lead">Ficha técnica resumida. Los casos son <strong>reales</strong> (CDC-MINSA, datos abiertos). El modelo se entrenó con {A.periodo_entrenamiento} y se evaluó con {A.periodo_prueba}: un periodo que no vio y que incluye las epidemias de 2023 y 2024.</p>

  <section class="notice small">
    <strong>Lo que dicen los datos reales, sin adornos.</strong> Cuando hay casos recientes el modelo funciona bien (AUC {A.modelo.auc}). Pero los casos oficiales llegan con meses de retraso:
    el último que tenemos es de {fecha(datos.ultimo_caso_oficial)}. Por eso <strong>hoy se predice solo con clima</strong>, un modelo mucho más modesto (AUC {C.modelo.auc}) que sirve para <em>ordenar qué distritos vigilar primero</em>, no para calcular cuántos casos habrá. Conseguir los casos de 2026 es lo que más mejoraría el sistema.
  </section>

  <section class="two">
    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("activity", 20)} /> Con casos recientes</h2>
      <p class="small muted">El modelo completo, cuando los casos están al día. Se usa en los replays de 2017 y 2023 y se usará hoy apenas lleguen datos de 2026.</p>
      <div class="tiles">
        <div class="tile"><span class="eyebrow">Detecta brotes (AUC)</span><strong>{A.modelo.auc}</strong><span class="small muted">{A.linea_base_nombre}: {A.linea_base.auc} · {ic(A, "auc")}</span></div>
        <div class="tile"><span class="eyebrow">Anticipa brotes nuevos</span><strong>{nuevo.pr_auc}</strong><span class="small muted">PR-AUC; al azar sería {nuevo.tasa_brote}</span></div>
        <div class="tile"><span class="eyebrow">Recall</span><strong>{pc(A.modelo.recall)}</strong><span class="small muted">línea base: {pc(A.linea_base.recall)}</span></div>
        <div class="tile"><span class="eyebrow">Error en casos (MAE)</span><strong>{A.casos.mae_modelo_p50}</strong><span class="small muted">repetir 4 semanas: {A.casos.mae_linea_base_ultimas_4_semanas}</span></div>
        <div class="tile"><span class="eyebrow">Rango que acierta</span><strong>{pc(A.casos.cobertura_p10_p90)}</strong><span class="small muted">casos reales dentro de P10–P90 (ideal ≈ 80%)</span></div>
      </div>
    </div>
    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("rain", 20)} /> Solo clima (el de hoy)</h2>
      <p class="small muted">Lluvia, temperatura, El Niño y calendario. Es lo único que llega al día; sirve para priorizar, con confianza limitada.</p>
      <div class="tiles">
        <div class="tile"><span class="eyebrow">Ordena el riesgo (AUC)</span><strong>{C.modelo.auc}</strong><span class="small muted">{C.linea_base_nombre}: {C.linea_base.auc} · {ic(C, "auc")}</span></div>
        <div class="tile"><span class="eyebrow">Anticipa brotes nuevos</span><strong>{C.subconjuntos.anticipacion_brote_nuevo.pr_auc}</strong><span class="small muted">PR-AUC; al azar sería {C.subconjuntos.anticipacion_brote_nuevo.tasa_brote}</span></div>
        <div class="tile"><span class="eyebrow">Error en casos (MAE)</span><strong>{C.casos.mae_modelo_p50}</strong><span class="small muted">peor que repetir las últimas 4 semanas ({C.casos.mae_linea_base_ultimas_4_semanas}), que hoy no se puede</span></div>
        <div class="tile"><span class="eyebrow">Rango que acierta</span><strong>{pc(C.casos.cobertura_p10_p90)}</strong><span class="small muted">muy por debajo del 80% ideal: por eso la confianza nunca pasa de "media"</span></div>
      </div>
    </div>
  </section>

  <Acc title="Año por año: ¿qué pasa cuando el modelo ya vio la epidemia anterior?" icon="calendar" help="progresiva" summary={SUM.progresiva}>
    <p class="small muted">Evaluación progresiva: para cada año el modelo se entrena con <strong>todo lo anterior</strong> y se prueba en ese año. "Sin información" es predecir siempre la tasa de brote del entrenamiento: si el error del modelo no es menor, no aporta nada.</p>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Año</th><th>Semanas-distrito en brote</th><th colspan="3">Con casos recientes</th><th colspan="3">Solo clima</th></tr>
      <tr class="sub"><th></th><th></th><th>AUC</th><th>Error (Brier)</th><th>Rango acierta</th><th>AUC</th><th>Error (Brier)</th><th>Rango acierta</th></tr></thead>
      <tbody>
        {A.evaluacion_progresiva.map((r: any, i: number) => {
          const c = C.evaluacion_progresiva[i];
          return (
            <tr>
              <td><strong>{r.anio}</strong><br /><span class="small muted">entrena hasta {fecha(r.entrenamiento_hasta)}</span></td>
              <td>{pc(r.tasa_brote)}</td>
              <td>{r.auc}</td><td>{r.brier} <span class="small muted">(sin info: {r.brier_sin_informacion})</span></td><td>{pc(r.cobertura_p10_p90)}</td>
              <td>{c.auc}</td><td>{c.brier} <span class="small muted">(sin info: {c.brier_sin_informacion})</span></td><td>{pc(c.cobertura_p10_p90)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    </div>
    <p class="small muted">{texto2023}</p>
  </Acc>

  <Acc title="¿Qué tan seguras son estas cifras?" icon="scale" help="ic95" summary={SUM.ic}>
    <p class="small muted">Cada métrica trae su intervalo de confianza del 95%, calculado remuestreando <strong>distritos</strong> (no filas: las semanas de un mismo distrito se parecen demasiado y darían intervalos falsamente estrechos). Si dos intervalos no se tocan, la diferencia no es casualidad.</p>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Métrica</th><th>Con casos recientes</th><th>Solo clima (hoy)</th></tr></thead>
      <tbody>
        <tr><td>AUC del modelo</td><td><strong>{A.modelo.auc}</strong> <span class="small muted">({ic(A, "auc")})</span></td><td><strong>{C.modelo.auc}</strong> <span class="small muted">({ic(C, "auc")})</span></td></tr>
        <tr><td>AUC de la línea base</td><td>{A.linea_base.auc} <span class="small muted">({ic(A, "auc_linea_base")})</span></td><td>{C.linea_base.auc} <span class="small muted">({ic(C, "auc_linea_base")})</span></td></tr>
        <tr><td>Ventaja sobre la línea base (AUC)</td><td><strong>+{(A.modelo.auc - A.linea_base.auc).toFixed(3)}</strong> <span class="small muted">({ic(A, "auc_ventaja")})</span></td><td><strong>+{(C.modelo.auc - C.linea_base.auc).toFixed(3)}</strong> <span class="small muted">({ic(C, "auc_ventaja")})</span></td></tr>
        <tr><td>Recall</td><td>{pc(A.modelo.recall)} <span class="small muted">({ic(A, "recall", true)})</span></td><td>{pc(C.modelo.recall)} <span class="small muted">({ic(C, "recall", true)})</span></td></tr>
        <tr><td>Error en casos (MAE)</td><td>{A.casos.mae_modelo_p50} <span class="small muted">({ic(A, "mae_p50")})</span></td><td>{C.casos.mae_modelo_p50} <span class="small muted">({ic(C, "mae_p50")})</span></td></tr>
        <tr><td>Casos reales dentro de P10–P90 (ideal 80%)</td><td>{pc(A.casos.cobertura_p10_p90)} <span class="small muted">({ic(A, "cobertura_p10_p90", true)})</span></td><td>{pc(C.casos.cobertura_p10_p90)} <span class="small muted">({ic(C, "cobertura_p10_p90", true)})</span></td></tr>
      </tbody>
    </table>
    </div>
    <p class="small muted">La ventaja del modelo con casos sobre el criterio actual del MINSA es clara (los intervalos no se tocan). La del modelo solo clima sobre el calendario es real pero modesta. Son 47 distritos: cualquier cifra por distrito suelto es bastante más incierta que el conjunto.</p>
  </Acc>

  <Acc title="Calibración de la intensidad" icon="trendingUp" help="calibracion" summary={SUM.calib}>
    <p class="small muted">El modelo ordena bien los distritos, pero en las epidemias grandes se quedaba corto. Para corregirlo, en cada semana se compara lo que realmente pasó con lo que el modelo había previsto en las últimas 4 semanas ya conocidas, y se reescalan los casos esperados ({cal.regla}). Solo usa información que existía ese día y solo se aplica al modelo con casos recientes.</p>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Año</th><th>Observado ÷ previsto<br /><span class="small muted">antes → después (1 = sin sesgo)</span></th><th>Rango P10–P90 acierta<br /><span class="small muted">antes → después (ideal 80%)</span></th></tr></thead>
      <tbody>
        {cal.por_anio.map((r: any) => (
          <tr>
            <td><strong>{r.anio}</strong></td>
            <td>{r.razon_observado_previsto_antes.toFixed(2)} → <strong>{r.razon_observado_previsto_despues.toFixed(2)}</strong></td>
            <td>{pc(r.cobertura_p10_p90_antes)} → <strong>{pc(r.cobertura_p10_p90_despues)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
    <p class="small muted"><strong>Resultado:</strong> en las epidemias de 2023 y 2024 el sesgo baja de {cal.por_anio.find((r: any) => r.anio === 2023).razon_observado_previsto_antes}× y {cal.por_anio.find((r: any) => r.anio === 2024).razon_observado_previsto_antes}× a casi 1, y el rango se acerca al 80%. <strong>Costo:</strong> el error medio sube de {cal.total.mae_p50_antes} a {cal.total.mae_p50_despues} casos, porque en años tranquilos el ajuste a veces se pasa. En 2022 y 2025 hubo poco que corregir.</p>
    <p class="data-note warn"><span><strong>Con solo clima no se puede usar este factor:</strong> sin casos recientes no se conoce lo que pasó en las últimas 4 semanas. Su sesgo sin ajuste es grande: lo observado fue {sesgoC["2023"]}× lo previsto en 2023 y {sesgoC["2024"]}× en 2024. Por eso hoy se corrige con el acumulado oficial del año (apartado siguiente).</span></p>
  </Acc>

  {ytd && ytdT && (
  <Acc title="Ajuste con el acumulado oficial del año (el que se aplica hoy)" icon="trendingUp" help="ajuste_acumulado" summary={SUM.ytd}>
    <p class="small muted">Con solo clima no hay casos recientes con qué calibrar, pero el CDC publica cada semana el total de casos del año por departamento y los casos por distrito de los distritos con más casos. Se estima cuántos casos ha tenido el piloto en lo que va del año ({ytd.regla}) y se compara con lo que el modelo había previsto para esas mismas semanas. El factor se aplica a los casos esperados (P10, P50 y P90).</p>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Año</th><th>Observado ÷ previsto<br /><span class="small muted">antes → después (1 = sin sesgo)</span></th><th>Error por distrito<br /><span class="small muted">antes → después (casos)</span></th><th>Rango P10–P90 acierta<br /><span class="small muted">antes → después (ideal 80%)</span></th></tr></thead>
      <tbody>
        {ytd.prueba_2022_2025.por_anio.map((r: any) => (
          <tr>
            <td><strong>{r.anio}</strong></td>
            <td>{r.antes.razon_observado_previsto.toFixed(2)} → <strong>{r.despues.razon_observado_previsto.toFixed(2)}</strong></td>
            <td>{r.antes.mae_por_distrito} → <strong>{r.despues.mae_por_distrito}</strong></td>
            <td>{pc(r.antes.cobertura_p10_p90)} → <strong>{pc(r.despues.cobertura_p10_p90)}</strong></td>
          </tr>
        ))}
        <tr class="sub"><td><strong>Total</strong></td><td>{ytdT.antes.razon_observado_previsto} → <strong>{ytdT.despues.razon_observado_previsto}</strong></td><td>{ytdT.antes.mae_por_distrito} → <strong>{ytdT.despues.mae_por_distrito}</strong></td><td>{pc(ytdT.antes.cobertura_p10_p90)} → <strong>{pc(ytdT.despues.cobertura_p10_p90)}</strong></td></tr>
      </tbody>
    </table>
    </div>
    <p class="small muted"><strong>Resultado:</strong> el sesgo baja de {ytdT.antes.razon_observado_previsto}× a {ytdT.despues.razon_observado_previsto}×, el rango se acerca al 80% y el error por distrito baja {Math.round((1 - ytdT.despues.mae_por_distrito / ytdT.antes.mae_por_distrito) * 100)}%. El ajuste está amortiguado a propósito: con el factor completo el sesgo se corregía más, pero el error por distrito empeoraba. <strong>Límite:</strong> corrige la magnitud, no el reparto entre distritos, y aun así tiende a quedarse corto.</p>
    {ytd.hoy && (
      <>
        <h3 class="inline-ico"><Fragment set:html={icon("map", 18)} /> Factores de hoy (informe del CDC, semana {ytd.hoy.informe.semana_epidemiologica})</h3>
        <div class="table-wrap">
        <table>
          <thead><tr><th>Departamento</th><th>Casos 2026 del departamento</th><th>Estimado en el piloto</th><th>Previsto por el modelo</th><th>Factor aplicado</th></tr></thead>
          <tbody>
            {Object.entries(ytd.hoy.por_departamento).map(([d, v]: [string, any]) => (
              <tr><td>{d}</td><td>{v.casos_departamento_2026.toLocaleString("es-PE")}</td><td>{v.casos_estimados_piloto.toLocaleString("es-PE")} <span class="small muted">({pc(v.participacion_piloto)} del departamento)</span></td><td>{v.casos_previstos_por_el_modelo.toLocaleString("es-PE")}</td><td><strong>×{v.factor.toFixed(1)}</strong></td></tr>
            ))}
          </tbody>
        </table>
        </div>
        <p class="small muted">Fuente: <a href={ytd.hoy.informe.url} target="_blank" rel="noopener">informe de dengue del CDC, semana {ytd.hoy.informe.semana_epidemiologica} de {ytd.hoy.informe.anio}</a>. La participación del piloto sale de los tres años anteriores.</p>
      </>
    )}
  </Acc>
  )}

  <Acc title="Validación externa con datos de 2026 (Piura)" icon="shield" help="validacion_externa" summary={SUM.val}>
    <p class="small muted">Prueba con datos que el modelo de hoy nunca vio: los casos 2025–2026 del Gobierno Regional de Piura, de {val.periodo_prueba} ({val.distritos_piura} distritos). Sus conteos no son comparables con los del CDC (otro sistema), así que "actividad alta" se define de forma relativa: casos de las próximas 4 semanas sobre el percentil 75 de ese mismo distrito.</p>
    <div class="tiles">
      <div class="tile"><span class="eyebrow">Ordena la actividad (AUC)</span><strong>{val.ordenamiento.auc_modelo_clima}</strong><span class="small muted">solo calendario: {val.ordenamiento.auc_linea_base_calendario}</span></div>
      <div class="tile"><span class="eyebrow">Correlación de rangos</span><strong>{val.ordenamiento.correlacion_rangos_casos_previstos_vs_gore}</strong><span class="small muted">casos previstos contra casos notificados</span></div>
      <div class="tile"><span class="eyebrow">Entre distritos, semana a semana</span><strong>{val.ordenamiento.correlacion_media_por_semana_entre_distritos}</strong><span class="small muted">¿ordena qué distrito va peor?</span></div>
    </div>
    <p class="small muted"><strong>¿Sirven los casos recientes del Gobierno Regional como señal de arrastre?</strong> AUC {val.arrastre.solo_modelo_clima.auc} solo con el modelo contra {val.arrastre.modelo_clima_mas_arrastre.auc} sumando esa señal (diferencia {val.arrastre.mejora_auc}, intervalo del 95%: {val.arrastre.mejora_auc_ic95[0]} a {val.arrastre.mejora_auc_ic95[1]}). {val.arrastre.conclusion}</p>
  </Acc>

  <Acc title="¿Podemos confiar en el porcentaje? ¿En qué se fijan los modelos?" icon="shield" help="prob_brote" summary={SUM.conf}>
  <section class="two">
    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("shield", 20)} /> ¿Podemos confiar en el porcentaje?</h2>
      <p class="small muted">Modelo con casos. Si dice 70%, el brote debería ocurrir ~7 de cada 10 veces. Los puntos por encima de la diagonal muestran que <strong>subestima</strong> las epidemias de 2023–24 (que no vio): ordena bien, pero se queda corto.</p>
      <svg viewBox={`0 0 ${S} ${S}`} width="100%" style="max-width:420px" role="img" aria-label="Diagrama de confiabilidad">
        {[0, 0.5, 1].map((t) => (
          <>
            <line x1={sx(0)} x2={sx(1)} y1={sy(t)} y2={sy(t)} stroke="var(--border)" />
            <text x={P - 6} y={sy(t) + 4} font-size="10" text-anchor="end" fill="var(--text-3)">{Math.round(t * 100)}%</text>
            <text x={sx(t)} y={S - P + 14} font-size="10" text-anchor="middle" fill="var(--text-3)">{Math.round(t * 100)}%</text>
          </>
        ))}
        <line x1={sx(0)} y1={sy(0)} x2={sx(1)} y2={sy(1)} stroke="var(--threshold)" stroke-dasharray="3 3" />
        <polyline points={rel.map((r) => `${sx(r.predicho)},${sy(r.observado)}`).join(" ")} fill="none" stroke="var(--series-1)" stroke-width="2" />
        {rel.map((r) => (
          <circle cx={sx(r.predicho)} cy={sy(r.observado)} r="5" fill="var(--series-1)" stroke="var(--surface)" stroke-width="2">
            <title>Predicho {Math.round(r.predicho * 100)}% → ocurrió {Math.round(r.observado * 100)}% ({r.n} casos)</title>
          </circle>
        ))}
        <text x={sx(0.5)} y={S - 4} font-size="10" text-anchor="middle" fill="var(--text-2)">Probabilidad predicha</text>
      </svg>
      <div class="legend"><span><i style="background:var(--series-1)"></i>Modelo</span><span><i style="background:repeating-linear-gradient(90deg,var(--threshold) 0 3px,transparent 3px 6px)"></i>Calibración perfecta</span></div>
    </div>

    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("cpu", 20)} /> ¿En qué se fijan los modelos?</h2>
      <p class="small muted"><strong>Con casos:</strong> los casos de esta semana pesan más que todo lo demás (un brote en curso tiende a seguir).</p>
      <ul class="imp">
        {impA.map(([k, v]) => (
          <li><span>{NAMES[k] ?? k}</span><span class="bar"><i style={`width:${(v / impA[0][1]) * 100}%;background:var(--series-1)`}></i></span><span class="num">{Math.round(v * 100)}%</span></li>
        ))}
      </ul>
      <p class="small muted" style="margin-top:14px"><strong>Solo clima:</strong> sin casos, pesan el calendario del brote, El Niño y la lluvia acumulada de hace 2 a 3 meses.</p>
      <ul class="imp">
        {impC.map(([k, v]) => (
          <li><span>{NAMES[k] ?? k}</span><span class="bar"><i style={`width:${(v / impC[0][1]) * 100}%;background:var(--series-2)`}></i></span><span class="num">{Math.round(v * 100)}%</span></li>
        ))}
      </ul>
    </div>
  </section>
  </Acc>

  <Acc title="Otras enfermedades" icon="activity" help="enfermedades" summary={SUM.otras}>
    <p class="small muted">Modelos más simples (regresión logística) que estiman la probabilidad de semanas de riesgo alto (casos sobre el percentil 80 del distrito). Las cuatro primeras usan casos <strong>reales</strong>; el golpe de calor es simulado.</p>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Enfermedad</th><th>Casos</th><th>AUC con casos recientes</th><th>AUC solo clima (hoy)</th><th>Detonante climático</th></tr></thead>
      <tbody>
        {Object.entries(otras).map(([k, v]: [string, any]) => (
          <tr>
            <td>{DISEASE[k]?.nombre ?? k}</td>
            <td>{k === "golpe_calor" ? <span class="badge lvl-medio">simulados</span> : <span class="badge lvl-bajo">reales</span>}</td>
            <td>{v.auc}</td><td>{otrasClima[k]?.auc ?? "—"}</td>
            <td class="muted small">{{ leptospirosis: "Lluvias intensas e inundaciones", eda: "Calor y falta de agua segura", golpe_calor: "Temperatura máxima extrema", ira: "Cambios bruscos de temperatura" }[k]}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </Acc>

  <Acc title="Monitoreo y reentrenamiento automático" icon="refresh" help="psi" summary={SUM.mon}>
  <p class="small muted">Cada semana el sistema revisa si los datos cambiaron, si el modelo de hoy sigue acertando y, si hace falta, prueba un modelo nuevo contra el actual.</p>
  <p><span class={`badge lvl-${stateLevel}`}>{stateLabel}</span></p>
  {mon.motivos.length > 0 && (
    <p class="notice small"><strong>Qué detectó el monitoreo:</strong> {mon.motivos.join("; ")}.</p>
  )}

  <section class="two">
    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("database", 20)} /> ¿Cambiaron los datos?</h2>
      <p class="small muted">Índice de estabilidad (PSI) de la ventana {mon.ventana_reciente.desde} → {mon.ventana_reciente.hasta} frente a la misma época de 2015–2021. Menos de 0,10 = estable; más de 0,25 = deriva fuerte. Solo se vigilan el clima y El Niño, porque son los datos que llegan al día.</p>
      <ul class="drift">
        {driftTop.map((d: any) => (
          <li>
            <span>{d.nombre}</span>
            <span class="bar" title={`PSI ${d.psi}`}><i style={`width:${Math.min(d.psi, 1) * 100}%;background:${d.estado === "alerta" ? "var(--critical)" : d.estado === "vigilar" ? "var(--warning)" : "var(--good)"}`}></i></span>
            <span class="num">{d.psi}</span>
            <span class={`badge lvl-${driftLevel[d.estado]}`}>{driftLabel[d.estado]}</span>
            <span class="small muted">{d.fuera_de_rango_pct > 0 ? `${d.fuera_de_rango_pct}% fuera del rango visto` : ""}</span>
          </li>
        ))}
      </ul>
      <p class="small muted">El mar Niño 1+2 hoy está en {mon.deriva_variables.find((d: any) => d.variable === "nino12")?.reciente_max} °C; en el entrenamiento original el máximo fue {mon.deriva_variables.find((d: any) => d.variable === "nino12")?.entrenamiento_max} °C: el modelo extrapola.</p>
    </div>

    <div class="card">
      <h2 class="chart-title"><Fragment set:html={icon("chart", 20)} /> ¿Sigue acertando?</h2>
      <p class="small muted">Error de las probabilidades (Brier, menos es mejor) del modelo de hoy por trimestre, hasta {lastQ}, el último con casos oficiales conocidos. La línea es el error de validación; en rojo, más de 1,5× esa línea.</p>
      <svg viewBox={`0 0 ${QW} ${QH}`} width="100%" style="max-width:520px" role="img" aria-label="Error del modelo por trimestre">
        {[0, 0.5, 1].map((t) => (
          <>
            <line x1={QL} x2={QW - 10} y1={qy(t * qMax)} y2={qy(t * qMax)} stroke="var(--border)" />
            <text x={QL - 6} y={qy(t * qMax) + 4} font-size="10" text-anchor="end" fill="var(--text-3)">{(t * qMax).toFixed(2)}</text>
          </>
        ))}
        <line x1={QL} x2={QW - 10} y1={qy(qRef)} y2={qy(qRef)} stroke="var(--threshold)" stroke-width="1.5" stroke-dasharray="5 4" />
        <text x={QW - 12} y={qy(qRef) - 5} font-size="10" text-anchor="end" fill="var(--text-2)">validación {qRef}</text>
        {qs.map((q: any, i: number) => (
          <>
            <rect x={qx(i) - qbw / 2} y={qy(q.brier)} width={qbw} height={Math.max(1, QH - QB - qy(q.brier))} rx="3" fill={q.brier > 1.5 * qRef ? "var(--critical)" : "var(--series-1)"}>
              <title>{q.periodo}: Brier {q.brier} · {q.n} semanas-distrito · tasa de brote {q.tasa_brote}</title>
            </rect>
            <text x={qx(i)} y={QH - QB + 14} font-size="9.5" text-anchor="middle" fill="var(--text-3)" transform={`rotate(-35 ${qx(i)} ${QH - QB + 14})`}>{q.periodo}</text>
          </>
        ))}
      </svg>
      <p class="small muted">Brier reciente (últimos 2 trimestres con casos): <strong>{mon.brier_reciente}</strong> frente a <strong>{mon.brier_validacion}</strong> en validación.</p>
    </div>
  </section>
  </Acc>

  <Acc title="Campeón contra retador" icon="award" help="campeon_retador" summary={SUM.champ}>
    <p class="small muted">Se entrena un modelo nuevo con todo lo etiquetado hasta {rt.ventana_comparacion.desde} y ambos se comparan en las {rt.ventana_comparacion.semanas} semanas siguientes ({rt.ventana_comparacion.desde} → {rt.ventana_comparacion.hasta}, un año completo para no caer solo en la temporada baja), que ninguno vio al entrenar.</p>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Modelo</th><th>Brier</th><th>AUC</th><th>Error en casos (MAE)</th><th>Rango que acierta</th></tr></thead>
      <tbody>
        <tr class="sub"><td colspan="5"><strong>Solo clima (el de hoy)</strong></td></tr>
        <tr><td><strong>Campeón</strong> <span class="small muted">{rt.campeon.nombre}</span></td><td>{rt.campeon.brier}</td><td>{fmt1(rt.campeon.auc)}</td><td>{rt.campeon.mae_casos_p50}</td><td>{pc(rt.campeon.cobertura_p10_p90)}</td></tr>
        <tr><td><strong>Retador</strong> <span class="small muted">{rt.retador.nombre}</span></td><td>{rt.retador.brier}</td><td>{fmt1(rt.retador.auc)}</td><td>{rt.retador.mae_casos_p50}</td><td>{pc(rt.retador.cobertura_p10_p90)}</td></tr>
        <tr class="sub"><td colspan="5"><strong>Con casos recientes</strong> — {rt.familias.casos.decision}</td></tr>
        <tr><td><strong>Campeón</strong></td><td>{rt.familias.casos.campeon.brier}</td><td>{fmt1(rt.familias.casos.campeon.auc)}</td><td>{rt.familias.casos.campeon.mae_casos_p50}</td><td>{pc(rt.familias.casos.campeon.cobertura_p10_p90)}</td></tr>
        <tr><td><strong>Retador</strong></td><td>{rt.familias.casos.retador.brier}</td><td>{fmt1(rt.familias.casos.retador.auc)}</td><td>{rt.familias.casos.retador.mae_casos_p50}</td><td>{pc(rt.familias.casos.retador.cobertura_p10_p90)}</td></tr>
      </tbody>
    </table>
    </div>
    <p class={`verdict ${rt.decision === "promovido" ? "ok" : ""}`}>
      <Fragment set:html={icon(rt.decision === "promovido" ? "checkCircle" : "info", 18)} />
      <span><strong>Modelo de hoy: {rt.decision === "promovido" ? "el retador fue promovido a producción." : "se mantiene el campeón."}</strong> {rt.motivo} <span class="muted">{rt.regla}</span> El año de comparación ({rt.ventana_comparacion.desde} a {rt.ventana_comparacion.hasta}) fue tranquilo, así que no pone a prueba del todo a un modelo entrenado también con las epidemias de 2023–24. Aun así, el límite del modelo solo clima es la falta de casos recientes, no la cantidad de años.</span>
    </p>
    <p class="small muted">Los replays de 2017 y 2023 usan el campeón de evaluación, que nunca vio esas epidemias. Cada entrenamiento queda registrado (MLflow y <code>experiments.jsonl</code>).</p>
  </Acc>

  <Acc title="Lluvias extremas: ¿el índice funciona?" icon="flood" help="lluvias_extremas" summary={SUM.lluvia}>
    <p class="small muted">{ext.metodo} Días-distrito sobre el umbral extremo por año: debe destacar los años de Niño costero. Los umbrales se fijaron con 2015–2021, así que 2023 no se usó para calibrarlos.</p>
    <svg viewBox={`0 0 ${FW} ${FH}`} width="100%" style="max-width:560px" role="img" aria-label="Días-distrito sobre el umbral extremo por año">
      {[0, 0.5, 1].map((t) => (
        <>
          <line x1={FL} x2={FW - 10} y1={fy(t * fMax)} y2={fy(t * fMax)} stroke="var(--border)" />
          <text x={FL - 6} y={fy(t * fMax) + 4} font-size="10" text-anchor="end" fill="var(--text-3)">{Math.round(t * fMax)}</text>
        </>
      ))}
      {yearsData.map(([y, v], i) => (
        <>
          <rect x={FL + i * fSlot + fSlot * 0.17} y={fy(v)} width={fSlot * 0.66} height={Math.max(1, FH - FB - fy(v))} rx="3" fill={y === "2017" || y === "2023" ? "var(--critical)" : "var(--series-1)"}>
            <title>{y}: {v} días-distrito</title>
          </rect>
          {v > 0 && <text x={FL + i * fSlot + fSlot / 2} y={fy(v) - 4} font-size="10" text-anchor="middle" fill="var(--text-2)">{v}</text>}
          <text x={FL + i * fSlot + fSlot / 2} y={FH - FB + 14} font-size="10" text-anchor="middle" fill="var(--text-3)">{y}</text>
        </>
      ))}
    </svg>
    <p class="small muted">Rojo: 2017 (Niño costero) y 2023 (ciclón Yaku). No es un modelo entrenado con inundaciones reales (no hay inventario público por distrito): es un índice de umbrales, el enfoque habitual de las alertas por lluvia.</p>
  </Acc>

  <Acc title="De dónde salen los datos" icon="database" summary={SUM.datos}>
    <p class="small muted">Todo es abierto y se descarga solo, sin intervención manual. Licencia: {datos.licencia}. Fuente: {datos.cita}</p>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Dato</th><th>Origen</th><th>Datos hasta</th><th>Casos en nuestros 47 distritos</th></tr></thead>
      <tbody>
        {FUENTES.map((f) => {
          const c = cov[f.k];
          return (
            <tr>
              <td>{f.url ? <a href={f.url} target="_blank" rel="noopener">{f.n}</a> : f.n}</td>
              <td>{f.real ? <span class="badge lvl-bajo">real</span> : <span class="badge lvl-medio">simulado</span>} <span class="small muted">{c?.fuente}</span></td>
              <td>{c ? fecha(c.hasta) : "—"}{c?.ultima_semana_epidemiologica ? <div class="small muted">semana epidemiológica {c.ultima_semana_epidemiologica.replace("-SE", " · SE ")}</div> : null}</td>
              <td>{c?.casos_total != null ? c.casos_total.toLocaleString("es-PE") : "—"}</td>
            </tr>
          );
        })}
        <tr><td>Clima (lluvia, temperatura, humedad)</td><td><span class="badge lvl-bajo">real</span> <span class="small muted">Open-Meteo (reanálisis ERA5 y pronóstico de 16 días)</span></td><td>{fecha(app.escenarios.actual.ventana_lluvia.hasta)}</td><td>—</td></tr>
        <tr><td>El Niño (Niño 1+2 semanal, ONI)</td><td><span class="badge lvl-bajo">real</span> <span class="small muted">NOAA Climate Prediction Center</span></td><td>{fecha(app.escenarios.actual.semana)}</td><td>—</td></tr>
      </tbody>
    </table>
    </div>
    <ul class="small">
      <li><strong>El 2025 del archivo es válido:</strong> lo comprobamos contra el informe oficial de la DGE al 12/09/2026, donde la columna 2025 coincide exactamente con el archivo (Piura 1 020, Tumbes 970, Lambayeque 658 hasta la semana 36). Fue un año bajo después de las epidemias de 2023 y 2024. Antes lo habíamos descartado por error, creyéndolo incompleto.</li>
      <li><strong>Piura 2025–2026 (Gobierno Regional):</strong> se muestra como contexto y como validación externa, pero no entra al entrenamiento: sus conteos no son comparables con los del CDC (2025: 12 242 frente a 1 117), probablemente porque es otro sistema de registro.</li>
      <li><strong>Población y acceso a agua</strong> de cada distrito son aproximados (orden de magnitud INEI). Los casos se cruzan por código oficial (UBIGEO), no por nombre.</li>
    </ul>
  </Acc>

  <Acc title="Límites y uso responsable" icon="info" summary={SUM.limites}>
    <ul class="small">
      <li>Es un sistema de <strong>apoyo a la decisión</strong>: no reemplaza la vigilancia epidemiológica ni los comunicados del MINSA y el ENFEN.</li>
      <li><strong>Hoy no hay casos oficiales recientes</strong> (último: {fecha(datos.ultimo_caso_oficial)}). La predicción de hoy usa solo clima y no calcula bien cuántos casos habrá: sirve para priorizar la vigilancia.</li>
      <li>Un caso notificado no es una infección: más casos pueden ser más contagio, más pruebas o más notificación.</li>
      <li>El golpe de calor es el único dato simulado (no hay fuente abierta); el resto de enfermedades usa casos reales.</li>
      <li>La IA solo redacta explicaciones con los números del modelo; no diagnostica ni receta. No se usan datos personales: todo es agregado por distrito y semana.</li>
      <li>El monitoreo semanal mide la deriva de los datos y el error reciente; si hace falta, un retador compite contra el modelo actual y solo se promueve si mejora de forma clara.</li>
      <li>El plan de brigadas usa supuestos editables (efectividad, capacidad y costos de ejemplo): es una guía de priorización, no una orden de operaciones.</li>
    </ul>
  </Acc>

  <Acc title="Arquitectura" icon="layers" summary={SUM.arq}>
    <pre class="arch">Python (ml/) ─ ingest (clima, incremental) → ingest_cases (CDC-MINSA) → build_cases → train → monitor → retrain → export
   │  dos modelos: con casos recientes · solo clima (el de hoy) · índice de lluvias extremas
   │  evaluación progresiva por año · campeón vs retador · registro MLflow
   ▼
app.json + series.json + modelos .onnx ──▶ Astro en Cloudflare (este sitio, instalable como app)
                               ├─ simulador y plan de brigadas en el navegador
                               ├─ /api/explicar → Workers AI (Llama 3.3)
                               └─ /api/alertas → alertas push (Web Push)
FastAPI (api/) + Docker ──▶ /predict · /predict/batch · /optimize · /monitoreo · /health</pre>
    <p class="small muted">Datos generados el {app.generado}.</p>
  </Acc>
</Layout>

<style>
  .lead { max-width: 860px; }
  .notice { margin: 16px 0; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 10px; }
  .tile { display: flex; flex-direction: column; gap: 2px; background: var(--surface-2); border-radius: 10px; padding: 10px 12px; }
  .tile strong { font-size: 1.6rem; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px; margin-bottom: 16px; }
  section.card { margin-bottom: 16px; }
  .imp { list-style: none; padding: 0; margin: 6px 0 0; }
  .imp li { display: grid; grid-template-columns: minmax(0, 1.6fr) 1fr 40px; gap: 10px; align-items: center; padding: 6px 0; font-size: 0.88rem; border-top: 1px solid var(--border); }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 8px 6px; border-top: 1px solid var(--border); vertical-align: top; }
  th { color: var(--text-2); font-weight: 600; }
  tr.sub td, tr.sub th { background: var(--surface-2); font-size: 0.85rem; }
  .arch { background: var(--surface-2); padding: 14px; border-radius: 10px; overflow-x: auto; font-size: 0.8rem; }
  .mon-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; flex-wrap: wrap; }
  .mon-head .chart-title { margin-bottom: 4px; }
  .drift { list-style: none; padding: 0; margin: 8px 0; }
  .drift li { display: grid; grid-template-columns: minmax(0, 1.5fr) 0.9fr 44px auto; gap: 8px 10px; align-items: center; padding: 8px 0; border-top: 1px solid var(--border); font-size: 0.88rem; }
  .drift li > span:last-child { grid-column: 1 / -1; margin-top: -4px; }
  .verdict { display: flex; gap: 8px; align-items: flex-start; background: var(--surface-2); border-radius: 10px; padding: 10px 12px; margin: 12px 0; font-size: 0.92rem; }
  .verdict.ok { background: var(--good-soft); }
  .limits ul, section.card > ul { padding-left: 18px; }
  @media (max-width: 600px) { .two { grid-template-columns: 1fr; } }
</style>
