{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "alerta-salud-nino",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Workers AI para las explicaciones en lenguaje simple (/api/explicar)
	"ai": {
		"binding": "AI",
		"remote": true
	},
	// Suscripciones a alertas push (solo distrito + dirección técnica del navegador)
	"kv_namespaces": [{ "binding": "ALERTAS" }],
	"observability": {
		"enabled": true
	}
}
